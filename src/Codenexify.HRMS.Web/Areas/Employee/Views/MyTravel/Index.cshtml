@model IReadOnlyList<Codenexify.HRMS.Application.Strength.TravelRow>
@using Codenexify.HRMS.Domain.Strength
@{
    ViewData["Title"] = "Travel";
    var hasEmployee = (bool)ViewBag.HasEmployee;
    var toApprove = (IReadOnlyList<Codenexify.HRMS.Application.Strength.TravelRow>)ViewBag.ToApprove;
    var today = DateTime.Today.ToString("yyyy-MM-dd");
}
<div class="page-head"><div><h1>Travel</h1><div class="text-muted small">Request business travel; the travel desk books approved trips</div></div></div>

@if (toApprove.Count > 0)
{
    <div class="card mb-3 tone-amber"><div class="card-header">Your team's trips to approve</div>
        <ul class="list-group list-group-flush">
            @foreach (var t in toApprove)
            {
                <li class="list-group-item bg-transparent d-flex flex-wrap gap-2 justify-content-between align-items-center">
                    <span><a class="fw-semibold" href="/me/travel/@t.Id">@t.FromCity → @t.ToCity</a> <span class="small text-muted">· @t.EmployeeName · @t.DepartOn.ToString("dd MMM") · @t.Purpose</span></span>
                    <a class="btn btn-sm btn-soft" href="/me/travel/@t.Id">Review</a></li>
            }
        </ul>
    </div>
}

@if (hasEmployee)
{
    <div class="row g-3">
        <div class="col-xl-6">
            <div class="card"><div class="card-header">New travel request</div><div class="card-body">
                <form method="post" action="/me/travel" asp-antiforgery="true" class="row g-2">
                    <div class="col-12"><label class="form-label small" for="tp">Purpose</label><input id="tp" name="trip.Purpose" maxlength="300" required class="form-control" placeholder="e.g. Client workshop at Acme, Mumbai" /></div>
                    <div class="col-6"><label class="form-label small" for="tf">From</label><input id="tf" name="trip.FromCity" maxlength="100" required class="form-control" /></div>
                    <div class="col-6"><label class="form-label small" for="tt">To</label><input id="tt" name="trip.ToCity" maxlength="100" required class="form-control" /></div>
                    <div class="col-6"><label class="form-label small" for="td">Departure</label><input id="td" name="trip.DepartOn" type="date" min="@today" required class="form-control" /></div>
                    <div class="col-6"><label class="form-label small" for="tr">Return (blank = one way)</label><input id="tr" name="trip.ReturnOn" type="date" min="@today" class="form-control" /></div>
                    <div class="col-6"><label class="form-label small" for="tm">Mode</label>
                        <select id="tm" name="trip.Mode" class="form-select">@foreach (var m in Enum.GetValues<TravelMode>()) { <option value="@m" selected="@(m == TravelMode.Train)">@(m == TravelMode.OwnVehicle ? "Own vehicle" : m.ToString())</option> }</select></div>
                    <div class="col-6 d-flex align-items-end"><div class="form-check"><input class="form-check-input" type="checkbox" id="th" name="trip.NeedsAccommodation" value="true" /><input type="hidden" name="trip.NeedsAccommodation" value="false" /><label class="form-check-label" for="th">Needs a hotel</label></div></div>
                    <div class="col-6"><label class="form-label small" for="te">Estimated cost (₹)</label><input id="te" name="trip.EstimatedCost" type="number" min="0" step="1" class="form-control" /></div>
                    <div class="col-6"><label class="form-label small" for="ta">Advance needed (₹)</label><input id="ta" name="trip.AdvanceRequested" type="number" min="0" step="1" class="form-control" /></div>
                    <div class="col-12"><label class="form-label small" for="tn">Notes for the travel desk</label><textarea id="tn" name="trip.Notes" rows="2" maxlength="1000" class="form-control" placeholder="Preferred timings, seat, hotel area…"></textarea></div>
                    <div class="col-12 text-end"><button class="btn btn-accent" type="submit">Send for approval</button></div>
                </form>
            </div></div>
        </div>
        <div class="col-xl-6">
            <div class="card"><div class="card-header">My trips</div>
                @if (Model.Count == 0) { <div class="empty-state py-4"><i class="bi bi-airplane"></i>No trips yet.</div> }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var t in Model)
                        {
                            <li class="list-group-item bg-transparent d-flex justify-content-between align-items-center">
                                <span><a class="fw-semibold" href="/me/travel/@t.Id">@t.FromCity → @t.ToCity</a><div class="small text-muted">@t.DepartOn.ToString("dd MMM yyyy") · @t.Mode</div></span>
                                <span class="badge-status st-@Codenexify.HRMS.Web.TravelCss.Of(t.Status)">@t.Status</span></li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
}
else if (toApprove.Count == 0)
{
    <div class="card"><div class="card-body small text-muted"><i class="bi bi-info-circle me-1"></i>Your login is not linked to an employee record, so you can't request travel.</div></div>
}
