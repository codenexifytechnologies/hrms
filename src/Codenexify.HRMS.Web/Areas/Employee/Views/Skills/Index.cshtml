@model Codenexify.HRMS.Application.Performance.SkillProfile
@using Codenexify.HRMS.Application.CoreHr
@using Codenexify.HRMS.Application.Performance
@{
    ViewData["Title"] = "My skills";
    var catalog = (IReadOnlyList<SkillRow>)ViewBag.Catalog;
    var team = (IReadOnlyList<LookupItem>)ViewBag.Team;
    var listed = Model.Lines.Where(l => l.SelfLevel is not null).Select(l => l.SkillId).ToHashSet();
    var gaps = Model.Lines.Count(l => l.Gap > 0);
    ViewData["Mode"] = "self";
    ViewData["Action"] = "/me/skills";
}
<div class="page-head">
    <div><h1>My skills</h1><div class="text-muted small">@(Model.Designation is null ? "Rate yourself; your manager can add their assessment." : $"Your skills against what a {Model.Designation} needs")</div></div>
</div>

@if (gaps > 0) { <div class="alert alert-warning small"><i class="bi bi-arrow-up-right-circle me-1"></i>@gaps skill(s) are below what your role needs. Talk to your manager about training or a stretch project.</div> }

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card mb-3">@{ await Html.RenderPartialAsync("_SkillTable", Model, ViewData); }</div>
        <div class="card"><div class="card-header">Add a skill</div><div class="card-body">
            @if (catalog.Count == 0) { <div class="small text-muted">HR hasn't set up the skill catalog yet.</div> }
            else
            {
                <form method="post" action="/me/skills" asp-antiforgery="true" class="row g-2">
                    <div class="col-md-6"><select class="form-select" name="skillId" required aria-label="Skill"><option value="">Choose a skill…</option>
                        @foreach (var g in catalog.Where(s => !listed.Contains(s.Id)).GroupBy(s => s.Category))
                        {
                            <optgroup label="@g.Key">@foreach (var s in g) { <option value="@s.Id">@s.Name</option> }</optgroup>
                        }
                    </select></div>
                    <div class="col-md-4"><select class="form-select" name="level" aria-label="Your level">
                        @for (var i = 1; i <= 5; i++) { <option value="@i" selected="@(i == 3)">@i · @SkillService.LevelName(i)</option> }</select></div>
                    <div class="col-md-2"><button class="btn btn-accent w-100" type="submit">Add</button></div>
                    <div class="col-12 form-text">Missing a skill? Ask HR to add it to the catalog.</div>
                </form>
            }
        </div></div>
    </div>
    <div class="col-lg-4">
        @if (team.Count > 0)
        {
            <div class="card mb-3"><div class="card-header">My team</div>
                <div class="list-group list-group-flush">
                    @foreach (var t in team) { <a class="list-group-item list-group-item-action d-flex justify-content-between" href="/me/skills/people/@t.Id">@t.Name <i class="bi bi-chevron-right text-muted"></i></a> }
                </div></div>
        }
        <div class="card"><div class="card-body small">
            <div class="fw-semibold mb-1">Levels</div>
            <ol class="mb-0 ps-3">@foreach (var l in SkillService.Levels) { <li>@l</li> }</ol>
            <div class="text-muted mt-2">Where your manager has assessed a skill, their level counts for role requirements.</div>
        </div></div>
    </div>
</div>
