@model Codenexify.HRMS.Application.Payroll.DeclarationInput
@using Codenexify.HRMS.Application.Payroll
@using Codenexify.HRMS.Domain.Payroll
@{
    var fy = (int)ViewBag.Fy;
    ViewData["Title"] = "My tax declaration";
    var status = ViewBag.Status as DeclarationStatus?;
    var estimates = (IReadOnlyList<TaxEstimate>)ViewBag.Estimates;
    var locked = status == DeclarationStatus.Approved;
    var inr = System.Globalization.CultureInfo.GetCultureInfo("en-IN");
    string M(decimal v) => "₹" + v.ToString("N0", inr);
    var best = estimates.OrderBy(e => e.Computation.TotalTax).FirstOrDefault();
}
<div class="page-head"><div><h1>Tax declaration · FY @fy-@((fy + 1) % 100)</h1><div class="text-muted small">Choose your regime and declare investments. Payroll deducts TDS based on your submitted declaration.</div></div>
    @if (status is not null) { <span class="badge-status st-@(status switch { DeclarationStatus.Draft => "Inactive", DeclarationStatus.Submitted => "PendingVerification", _ => "Active" }) fs-6">@status</span> }</div>
@if (ViewBag.Form16Years is IReadOnlyList<int> f16 && f16.Count > 0)
{
    <div class="card mb-3"><div class="card-body d-flex flex-wrap align-items-center gap-2">
        <span class="fw-semibold me-2"><i class="bi bi-file-earmark-text me-1"></i>Form 16 (Part B)</span>
        @foreach (var y in f16) { <a class="btn btn-sm btn-soft" href="/me/tax/form16/@y"><i class="bi bi-file-earmark-pdf me-1"></i>FY @y-@((y + 1) % 100)</a> }
        <span class="small text-muted ms-md-auto">Part A comes from your employer via TRACES. The current year is provisional until March.</span>
    </div></div>
}
<div class="row g-3">
    <div class="col-xl-7">
        <div class="card"><div class="card-body">
            @if (locked) { <div class="alert alert-info small">Your declaration is approved. Ask payroll to reopen it if something changed.</div> }
            <form method="post" action="/me/tax" asp-antiforgery="true" novalidate>
                <fieldset disabled="@locked" class="row g-3">
                    <div class="col-12"><label class="form-label">Tax regime</label>
                        <div class="d-flex gap-4">
                            <div class="form-check"><input class="form-check-input" type="radio" asp-for="Regime" value="@TaxRegime.New" id="rn" /><label class="form-check-label" for="rn">New regime (default, fewer deductions)</label></div>
                            <div class="form-check"><input class="form-check-input" type="radio" asp-for="Regime" value="@TaxRegime.Old" id="ro" /><label class="form-check-label" for="ro">Old regime (HRA, 80C, 80D…)</label></div>
                        </div></div>
                    <div class="form-section-title col-12 mb-0">Old-regime deductions</div>
                    <div class="col-md-6"><label asp-for="Section80C" class="form-label"></label><input asp-for="Section80C" class="form-control" /><div class="form-text">Your PF contribution is added automatically.</div></div>
                    <div class="col-md-6"><label asp-for="Section80D" class="form-label"></label><input asp-for="Section80D" class="form-control" /></div>
                    <div class="col-md-6"><label asp-for="Section80CCD1B" class="form-label"></label><input asp-for="Section80CCD1B" class="form-control" /></div>
                    <div class="col-md-6"><label asp-for="HomeLoanInterest" class="form-label"></label><input asp-for="HomeLoanInterest" class="form-control" /></div>
                    <div class="col-md-6"><label asp-for="MonthlyRentPaid" class="form-label"></label><input asp-for="MonthlyRentPaid" class="form-control" /></div>
                    <div class="col-md-6 d-flex align-items-end"><div class="form-check form-switch"><input asp-for="MetroCity" class="form-check-input" /><label asp-for="MetroCity" class="form-check-label"></label></div></div>
                    <div class="col-md-6"><label asp-for="OtherDeductions" class="form-label"></label><input asp-for="OtherDeductions" class="form-control" /></div>
                    <div class="form-section-title col-12 mb-0">Previous employer (joined during this year)</div>
                    <div class="col-md-6"><label asp-for="PreviousEmployerIncome" class="form-label"></label><input asp-for="PreviousEmployerIncome" class="form-control" /></div>
                    <div class="col-md-6"><label asp-for="PreviousEmployerTds" class="form-label"></label><input asp-for="PreviousEmployerTds" class="form-control" /></div>
                    <div class="col-12 small text-muted">Upload proofs (rent receipts, premium receipts…) to payroll as documents when asked. Declared amounts may be adjusted after verification.</div>
                    <div class="col-12 d-flex justify-content-end gap-2">
                        <button class="btn btn-light border" type="submit" name="Submit" value="false">Save draft</button>
                        <button class="btn btn-accent" type="submit" name="Submit" value="true">Submit declaration</button>
                    </div>
                </fieldset>
            </form>
        </div></div>
    </div>
    <div class="col-xl-5">
        <div class="card"><div class="card-header">Estimated tax for the year</div><div class="card-body">
            @if (estimates.Count == 0) { <div class="text-muted small">Available once payroll has set your salary and the tax rules for this year exist.</div> }
            else
            {
                @foreach (var e in estimates)
                {
                    <div class="border rounded p-3 mb-2 @(e == best ? "border-success" : "")">
                        <div class="d-flex justify-content-between"><strong>@e.Regime regime</strong>@if (e == best) { <span class="badge text-bg-success">Lower</span> }</div>
                        <div class="small text-muted">Salary @M(e.AnnualGross) − deductions @M(e.Deductions) = taxable @M(e.Computation.TaxableIncome)</div>
                        <div class="fs-4 fw-bold">@M(e.Computation.TotalTax)</div>
                        <div class="small text-muted">Slab tax @M(e.Computation.SlabTax)@(e.Computation.Rebate > 0 ? $" − rebate {M(e.Computation.Rebate)}" : "")@(e.Computation.Surcharge > 0 ? $" + surcharge {M(e.Computation.Surcharge)}" : "") + cess @M(e.Computation.Cess)</div>
                    </div>
                }
                <div class="small text-muted">Estimate on your current salary and saved declaration (old regime uses the declared values). It is not tax advice.</div>
            }
        </div></div>
    </div>
</div>
