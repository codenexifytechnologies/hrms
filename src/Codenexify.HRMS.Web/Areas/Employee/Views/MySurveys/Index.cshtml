@model IReadOnlyList<Codenexify.HRMS.Application.Strength.SurveyRow>
@{ ViewData["Title"] = "Surveys"; }
<div class="page-head"><div><h1>Surveys</h1><div class="text-muted small">Tell us how things are going</div></div></div>
<div class="card">
    @if (Model.Count == 0) { <div class="empty-state"><i class="bi bi-clipboard-check"></i>No surveys waiting for you.</div> }
    else
    {
        <ul class="list-group list-group-flush">
            @foreach (var s in Model)
            {
                <li class="list-group-item bg-transparent d-flex justify-content-between align-items-center">
                    <span><a class="fw-semibold" href="/me/surveys/@s.Id">@s.Title</a>
                        <div class="small text-muted">@s.QuestionCount question(s) · @(s.IsAnonymous ? "anonymous" : "your name is shown with your answers") · open until @s.ClosesAtUtc?.ToLocalTime().ToString("dd MMM")</div></span>
                    <a class="btn btn-sm btn-accent" href="/me/surveys/@s.Id">Answer</a>
                </li>
            }
        </ul>
    }
</div>
