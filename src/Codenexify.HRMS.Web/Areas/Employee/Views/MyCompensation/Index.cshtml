@model IReadOnlyList<Codenexify.HRMS.Application.Performance.CompensationCycleRow>
@using Codenexify.HRMS.Web
@{ ViewData["Title"] = "Salary revisions"; }
<div class="page-head"><div><h1>Salary revisions</h1><div class="text-muted small">Plan raises for your team within the budget and guidelines HR set</div></div></div>
<div class="card">
    @if (Model.Count == 0) { <div class="empty-state"><i class="bi bi-cash-stack"></i>Nothing to plan right now. HR will let you know when a cycle opens.</div> }
    else
    {
        <div class="list-group list-group-flush">
            @foreach (var c in Model)
            {
                <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" href="/me/compensation/@c.Id">
                    <span><span class="fw-semibold">@c.Name</span> <span class="small text-muted">· effective @c.EffectiveOn.ToString("dd MMM yyyy")</span></span>
                    <span class="badge @CompUi.Css(c.Status)">@c.Status</span></a>
            }
        </div>
    }
</div>
