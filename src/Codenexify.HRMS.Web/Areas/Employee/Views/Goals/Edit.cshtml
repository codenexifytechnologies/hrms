@model Codenexify.HRMS.Application.Performance.GoalInput
@using Codenexify.HRMS.Application.CoreHr
@using Codenexify.HRMS.Application.Performance
@using Codenexify.HRMS.Domain.Performance
@{
    var id = ViewBag.Id as int?;
    ViewData["Title"] = id is null ? "New goal" : "Edit goal";
    var viewer = (GoalViewer)ViewBag.Viewer;
    var parents = (IReadOnlyList<GoalRow>)ViewBag.Parents;
    var departments = (IReadOnlyList<LookupItem>)ViewBag.Departments;
    var owners = (IReadOnlyList<LookupItem>)ViewBag.Owners;
}
<div class="page-head"><div><h1>@ViewData["Title"]</h1><div class="text-muted small"><a href="/me/goals">Goals</a></div></div></div>

<form method="post" action="@(id is null ? "/me/goals/new" : $"/me/goals/{id}/edit")" asp-antiforgery="true" novalidate style="max-width: 860px">
    <div asp-validation-summary="All" class="alert alert-danger py-2 small"></div>
    <div class="card mb-3"><div class="card-body row g-3">
        <div class="col-12"><label asp-for="Title" class="form-label">Objective</label><input asp-for="Title" class="form-control" placeholder="e.g. Make onboarding delightful for every new joiner" /></div>
        <div class="col-12"><label asp-for="Description" class="form-label">Why it matters (optional)</label><textarea asp-for="Description" rows="3" class="form-control"></textarea></div>

        @if (viewer.IsHr)
        {
            <div class="col-md-4"><label asp-for="Level" class="form-label"></label>
                <select asp-for="Level" class="form-select">
                    <option value="@GoalLevel.Individual" selected="@(Model.Level == GoalLevel.Individual)">Individual</option>
                    <option value="@GoalLevel.Department" selected="@(Model.Level == GoalLevel.Department)">Department</option>
                    <option value="@GoalLevel.Company" selected="@(Model.Level == GoalLevel.Company)">Company</option>
                </select></div>
            <div class="col-md-4"><label asp-for="DepartmentId" class="form-label">Department (department goals)</label>
                <select asp-for="DepartmentId" class="form-select"><option value="">—</option>
                    @foreach (var d in departments) { <option value="@d.Id" selected="@(Model.DepartmentId == d.Id)">@d.Name</option> }</select></div>
        }
        else
        {
            <input type="hidden" asp-for="Level" value="@GoalLevel.Individual" />
        }
        <div class="col-md-4"><label asp-for="OwnerEmployeeId" class="form-label">Owner (individual goals)</label>
            <select asp-for="OwnerEmployeeId" class="form-select">
                @if (viewer.EmployeeId is null) { <option value="">Choose…</option> }
                @foreach (var o in owners) { <option value="@o.Id" selected="@(Model.OwnerEmployeeId == o.Id || (Model.OwnerEmployeeId is null && o.Id == viewer.EmployeeId))">@o.Name@(o.Id == viewer.EmployeeId ? " (me)" : "")</option> }
            </select></div>

        <div class="col-md-8"><label asp-for="ParentGoalId" class="form-label"></label>
            <select asp-for="ParentGoalId" class="form-select"><option value="">— Not linked —</option>
                @foreach (var p in parents.Where(p => p.Id != id))
                {
                    <option value="@p.Id" selected="@(Model.ParentGoalId == p.Id)">@(p.Level == GoalLevel.Company ? "Company" : p.DepartmentName): @p.Title</option>
                }
            </select>
            <div class="form-text">Linking shows how this goal contributes to a company or department goal.</div></div>
        <div class="col-md-2"><label asp-for="StartsOn" class="form-label"></label><input asp-for="StartsOn" type="date" class="form-control" /></div>
        <div class="col-md-2"><label asp-for="DueOn" class="form-label"></label><input asp-for="DueOn" type="date" class="form-control" /></div>
    </div></div>
    <div class="d-flex justify-content-end gap-2">
        <a class="btn btn-light border" href="@(id is null ? "/me/goals" : $"/me/goals/{id}")">Cancel</a>
        <button class="btn btn-accent" type="submit">Save goal</button>
    </div>
    @if (id is null) { <p class="small text-muted mt-2">After saving, add key results: the measurable outcomes that show the goal is achieved.</p> }
</form>
