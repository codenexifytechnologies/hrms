@model IReadOnlyList<Codenexify.HRMS.Application.Strength.SignatureRow>
@using Codenexify.HRMS.Domain.Strength
@{ ViewData["Title"] = "Letters to sign"; }
<div class="page-head"><div><h1>Letters to sign</h1><div class="text-muted small">Review and accept letters from HR electronically</div></div></div>
<div class="card">
    @if (Model.Count == 0) { <div class="empty-state"><i class="bi bi-pen"></i>Nothing to sign.</div> }
    else
    {
        <ul class="list-group list-group-flush">
            @foreach (var r in Model)
            {
                <li class="list-group-item bg-transparent d-flex flex-wrap gap-2 justify-content-between align-items-center">
                    <span><a class="fw-semibold" href="/me/sign/@r.Id">@r.Subject</a><div class="small text-muted">@r.LetterNumber · from @r.RequestedBy, @r.RequestedAtUtc.ToLocalTime().ToString("dd MMM yyyy")</div></span>
                    @if (r.Status == SignatureStatus.Pending) { <a class="btn btn-sm btn-accent" href="/me/sign/@r.Id">Review &amp; sign</a> }
                    else if (r.SignedDocumentId is int d) { <a class="btn btn-sm btn-soft" href="/me/sign/signed/@d"><i class="bi bi-file-earmark-pdf me-1"></i>Signed copy</a> }
                    else { <span class="badge-status st-Inactive">@r.Status</span> }
                </li>
            }
        </ul>
    }
</div>
