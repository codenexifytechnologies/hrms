@model ShiftInput
@{
    var id = ViewBag.Id as int?;
    ViewData["Title"] = id is null ? "Add shift" : $"Edit {Model.Name}";
}
<div class="page-head"><div><h1>@ViewData["Title"]</h1>
    <nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/org/shifts">Shifts</a></li><li class="breadcrumb-item active">@(id is null ? "New" : Model.Code)</li></ol></nav></div></div>
<div class="card" style="max-width: 860px"><div class="card-body">
    <form method="post" action="/org/shifts/edit/@id" asp-antiforgery="true" class="row g-3" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small col-12"></div>
        <div class="col-md-8"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" placeholder="e.g. Night" /><span asp-validation-for="Name"></span></div>
        <div class="col-md-4"><label asp-for="Code" class="form-label"></label><input asp-for="Code" class="form-control text-uppercase" /><span asp-validation-for="Code"></span></div>
        <div class="col-md-3"><label asp-for="StartTime" class="form-label"></label><input asp-for="StartTime" type="time" class="form-control" /></div>
        <div class="col-md-3"><label asp-for="EndTime" class="form-label"></label><input asp-for="EndTime" type="time" class="form-control" /><div class="form-text">Earlier than start = ends next day.</div></div>
        <div class="col-md-3"><label asp-for="BreakMinutes" class="form-label"></label><input asp-for="BreakMinutes" class="form-control" /><span asp-validation-for="BreakMinutes"></span></div>
        <div class="col-md-3"><label asp-for="GraceMinutes" class="form-label"></label><input asp-for="GraceMinutes" class="form-control" /><span asp-validation-for="GraceMinutes"></span></div>
        <div class="col-md-4"><label asp-for="MinHoursFullDay" class="form-label"></label><input asp-for="MinHoursFullDay" class="form-control" step="0.25" /><span asp-validation-for="MinHoursFullDay"></span></div>
        <div class="col-md-4"><label asp-for="MinHoursHalfDay" class="form-label"></label><input asp-for="MinHoursHalfDay" class="form-control" step="0.25" /><span asp-validation-for="MinHoursHalfDay"></span></div>
        <div class="col-md-4"><label asp-for="OvertimeThresholdMinutes" class="form-label"></label><input asp-for="OvertimeThresholdMinutes" class="form-control" /></div>
        <div class="col-12"><label class="form-label">Weekly offs</label>
            <div class="d-flex flex-wrap gap-3">
                @foreach (var d in new[] { DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday })
                {
                    <div class="form-check"><input class="form-check-input" type="checkbox" name="WeeklyOffs" value="@d" id="wo-@d" checked="@Model.WeeklyOffs.Contains(d)" /><label class="form-check-label" for="wo-@d">@d</label></div>
                }
            </div></div>
        <div class="col-12 d-flex gap-4">
            <div class="form-check form-switch"><input asp-for="IsDefault" class="form-check-input" /><label asp-for="IsDefault" class="form-check-label"></label></div>
            <div class="form-check form-switch"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div>
        </div>
        <div class="col-12 d-flex justify-content-end gap-2"><a href="/org/shifts" class="btn btn-light border">Cancel</a><button class="btn btn-accent" type="submit">Save shift</button></div>
    </form>
</div></div>
