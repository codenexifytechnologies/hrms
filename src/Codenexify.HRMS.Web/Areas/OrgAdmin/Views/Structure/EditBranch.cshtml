@model BranchInput
@{
    ViewData["Title"] = "Edit branch";
    var id = ViewBag.Id ?? Context.GetRouteValue("id");
    var branch = Model;
}
<div class="page-head"><div><h1>Edit branch</h1>
    <nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/org/structure#branches">Organization structure</a></li><li class="breadcrumb-item active">@Model.Name</li></ol></nav></div></div>
<div class="card" style="max-width: 820px"><div class="card-body">
    <form method="post" action="/org/structure/savebranch/@id" asp-antiforgery="true" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
        <partial name="_BranchFields" for="@branch" />
        <div class="d-flex justify-content-end gap-2 mt-4"><a href="/org/structure#branches" class="btn btn-light border">Cancel</a><button class="btn btn-accent" type="submit">Save branch</button></div>
    </form>
</div></div>
