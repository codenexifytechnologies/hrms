@model IReadOnlyList<Codenexify.HRMS.Application.Performance.CompensationCycleRow>
@using Codenexify.HRMS.Web
@{ ViewData["Title"] = "Salary revisions"; }
<div class="page-head">
    <div><h1>Salary revisions</h1><div class="text-muted small">Merit cycles: a budget, raise guidelines by rating, managers plan their team, HR approves</div></div>
    <a class="btn btn-accent" href="/org/compensation/new"><i class="bi bi-plus-lg me-1"></i>New cycle</a>
</div>
<div class="card">
    @if (Model.Count == 0)
    {
        <div class="empty-state"><i class="bi bi-cash-stack"></i>No salary-revision cycles yet.<div class="mt-2"><a class="btn btn-sm btn-accent" href="/org/compensation/new">Create the first</a></div></div>
    }
    else
    {
        <div class="table-responsive"><table class="table table-hover align-middle mb-0">
            <thead><tr><th>Cycle</th><th>Effective</th><th class="text-end">People</th><th class="text-end">Budget</th><th class="text-end">Planned</th><th>Status</th></tr></thead>
            <tbody>@foreach (var c in Model)
            {
                <tr><td><a class="fw-semibold" href="/org/compensation/@c.Id">@c.Name</a></td><td class="small">@c.EffectiveOn.ToString("dd MMM yyyy")</td>
                    <td class="text-end">@c.People</td><td class="text-end">₹@c.Budget.ToString("N0")</td>
                    <td class="text-end @(c.Planned > c.Budget ? "text-danger" : "")">₹@c.Planned.ToString("N0")</td>
                    <td><span class="badge @CompUi.Css(c.Status)">@c.Status</span></td></tr>
            }</tbody>
        </table></div>
    }
</div>
