@model Codenexify.HRMS.Application.Planning.HeadcountPlanInput
@{
    var id = ViewBag.Id as int?;
    ViewData["Title"] = id is null ? "New headcount plan" : "Edit " + Model.Name;
}
<div class="page-head">
    <div><h1>@ViewData["Title"]</h1><div class="text-muted small"><a href="/org/headcount">Headcount planning</a></div></div>
</div>
<form method="post" action="@(id is null ? "/org/headcount/new" : $"/org/headcount/{id}/edit")" asp-antiforgery="true" novalidate style="max-width: 760px">
    <div asp-validation-summary="All" class="alert alert-danger py-2 small"></div>
    <div class="card mb-3"><div class="card-body row g-3">
        <div class="col-md-6"><label asp-for="Name" class="form-label">Plan name</label><input asp-for="Name" class="form-control" /></div>
        <div class="col-md-3"><label asp-for="StartsOn" class="form-label"></label><input asp-for="StartsOn" type="date" class="form-control" /></div>
        <div class="col-md-3"><label asp-for="EndsOn" class="form-label"></label><input asp-for="EndsOn" type="date" class="form-control" /></div>
        <div class="col-12"><label asp-for="Notes" class="form-label">Notes / assumptions</label><textarea asp-for="Notes" rows="4" class="form-control" placeholder="e.g. Sales grows 30% after the Series B; engineering backfills only."></textarea></div>
    </div></div>
    <div class="d-flex justify-content-end gap-2">
        <a class="btn btn-light border" href="@(id is null ? "/org/headcount" : $"/org/headcount/{id}")">Cancel</a>
        <button class="btn btn-accent" type="submit">Save plan</button>
    </div>
</form>
