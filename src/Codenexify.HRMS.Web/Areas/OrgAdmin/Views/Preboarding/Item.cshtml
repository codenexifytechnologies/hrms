@model Codenexify.HRMS.Application.Planning.PreboardingItemInput
@using Codenexify.HRMS.Domain.CoreHr
@using Codenexify.HRMS.Domain.Planning
@using Codenexify.HRMS.Web
@{
    var id = ViewBag.Id as int?;
    ViewData["Title"] = id is null ? "New checklist item" : Model.Title;
}
<div class="page-head">
    <div><h1>@ViewData["Title"]</h1><div class="text-muted small"><a href="/org/preboarding">Pre-boarding</a> / <a href="/org/preboarding/settings#items">Checklist</a></div></div>
    @if (id is not null)
    {
        <form method="post" action="/org/preboarding/items/@id/delete" asp-antiforgery="true" data-confirm-danger="Delete this item? If new hires already answered it, it's switched off instead.">
            <button class="btn btn-outline-danger" type="submit"><i class="bi bi-trash"></i></button></form>
    }
</div>
<form method="post" action="@(id is null ? "/org/preboarding/items/new" : $"/org/preboarding/items/{id}")" asp-antiforgery="true" novalidate style="max-width: 760px">
    <div asp-validation-summary="All" class="alert alert-danger py-2 small"></div>
    <div class="card mb-3"><div class="card-body row g-3">
        <div class="col-md-7"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" placeholder="e.g. PAN card copy" /></div>
        <div class="col-md-5"><label asp-for="Kind" class="form-label"></label>
            <select asp-for="Kind" class="form-select">
                @foreach (var k in Enum.GetValues<PreboardingItemKind>()) { <option value="@k" selected="@(Model.Kind == k)">@PlanningUi.Label(k)</option> }</select></div>
        <div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" rows="5" class="form-control" placeholder="For a document: what exactly to upload. For an acknowledgement: the text they read and accept."></textarea></div>
        <div class="col-md-4"><label asp-for="DocumentCategory" class="form-label"></label>
            <select asp-for="DocumentCategory" class="form-select">
                @foreach (var c in Enum.GetValues<DocumentCategory>().Where(c => c != DocumentCategory.Letter)) { <option value="@c" selected="@(Model.DocumentCategory == c)">@c</option> }</select>
            <div class="form-text">Documents only: where the file is filed on the employee record.</div></div>
        <div class="col-md-2"><label asp-for="SortOrder" class="form-label"></label><input asp-for="SortOrder" class="form-control" inputmode="numeric" /></div>
        <div class="col-md-3 d-flex align-items-end"><div class="form-check"><input asp-for="IsRequired" class="form-check-input" /><label asp-for="IsRequired" class="form-check-label"></label></div></div>
        <div class="col-md-3 d-flex align-items-end"><div class="form-check"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div></div>
        <div class="col-12 form-text mt-0">Keep it to what you really need before day one. Don't ask for a full Aadhaar copy; a masked one is enough.</div>
    </div></div>
    <div class="d-flex justify-content-end gap-2">
        <a class="btn btn-light border" href="/org/preboarding/settings#items">Cancel</a>
        <button class="btn btn-accent" type="submit">Save item</button>
    </div>
</form>
