@model Codenexify.HRMS.Application.Payroll.ComponentInput
@using Codenexify.HRMS.Domain.Payroll
@{
    var id = ViewBag.Id as int?;
    ViewData["Title"] = id is null ? "Add salary component" : $"Edit {Model.Name}";
}
<div class="page-head"><div><h1>@ViewData["Title"]</h1>
    <nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/org/payroll/structures">Salary structures</a></li><li class="breadcrumb-item active">Component</li></ol></nav></div></div>
<div class="card" style="max-width: 760px"><div class="card-body">
    <form method="post" action="/org/payroll/component/@id" asp-antiforgery="true" class="row g-3" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small col-12"></div>
        <div class="col-md-6"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" placeholder="e.g. Conveyance Allowance" /><span asp-validation-for="Name"></span></div>
        <div class="col-md-3"><label asp-for="Code" class="form-label"></label><input asp-for="Code" class="form-control text-uppercase" /><span asp-validation-for="Code"></span></div>
        <div class="col-md-3"><label asp-for="Type" class="form-label"></label><select asp-for="Type" asp-items="Html.GetEnumSelectList<ComponentType>()" class="form-select"></select></div>
        <div class="col-md-3"><label asp-for="SortOrder" class="form-label"></label><input asp-for="SortOrder" class="form-control" /></div>
        <div class="col-12 d-flex flex-wrap gap-4">
            <div class="form-check form-switch"><input asp-for="IsTaxable" class="form-check-input" /><label asp-for="IsTaxable" class="form-check-label"></label></div>
            <div class="form-check form-switch"><input asp-for="IsPfWage" class="form-check-input" /><label asp-for="IsPfWage" class="form-check-label"></label></div>
            <div class="form-check form-switch"><input asp-for="IsEsiWage" class="form-check-input" /><label asp-for="IsEsiWage" class="form-check-label"></label></div>
            <div class="form-check form-switch"><input asp-for="IsProrated" class="form-check-input" /><label asp-for="IsProrated" class="form-check-label"></label></div>
            <div class="form-check form-switch"><input asp-for="IsBasic" class="form-check-input" /><label asp-for="IsBasic" class="form-check-label"></label></div>
            <div class="form-check form-switch"><input asp-for="IsHra" class="form-check-input" /><label asp-for="IsHra" class="form-check-label"></label></div>
            <div class="form-check form-switch"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div>
        </div>
        <div class="col-12 d-flex justify-content-end gap-2"><a href="/org/payroll/structures" class="btn btn-light border">Cancel</a><button class="btn btn-accent" type="submit">Save component</button></div>
    </form>
</div></div>
