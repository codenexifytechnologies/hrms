@{
    ViewData["Title"] = "Form 16 & 24Q";
    var years = (IReadOnlyList<int>)ViewBag.Years;
    var people = (IReadOnlyList<Codenexify.HRMS.Application.CoreHr.LookupItem>)ViewBag.Employees;
    var can24Q = User.HasPermission(TenantPermissions.PayrollManage) && User.HasPermission(TenantPermissions.EmployeesSensitive);
    string Fy(int y) => $"{y}-{(y + 1) % 100:00}";
}
<div class="page-head"><div><h1>Form 16 &amp; 24Q</h1><div class="text-muted small">Annual salary TDS certificates and quarterly return data, from finalized payroll</div></div></div>
<partial name="_PayrollNav" />
@if (years.Count == 0)
{
    <div class="card"><div class="empty-state"><i class="bi bi-file-earmark-text"></i>No finalized payroll yet.</div></div>
}
else
{
    <div class="row g-3">
        <div class="col-lg-6">
            <div class="card h-100"><div class="card-header">Form 16 — Part B</div><div class="card-body">
                <form method="get" action="/org/payroll/returns/form16" class="row g-2">
                    <div class="col-12"><label class="form-label small" for="fe">Employee</label>
                        <select id="fe" name="employeeId" class="form-select" required><option value="">Choose…</option>@foreach (var p in people) { <option value="@p.Id">@p.Name</option> }</select></div>
                    <div class="col-6"><label class="form-label small" for="fy">Financial year</label>
                        <select id="fy" name="year" class="form-select">@foreach (var y in years) { <option value="@y">@Fy(y)</option> }</select></div>
                    <div class="col-6 d-flex align-items-end"><button class="btn btn-accent w-100" type="submit"><i class="bi bi-file-earmark-pdf me-1"></i>Download PDF</button></div>
                </form>
                <p class="small text-muted mt-3 mb-0">Part B shows salary, deductions, tax computation and month-wise TDS. Issue it with <strong>Part A from the TRACES portal</strong>. Employees can download their own Part B under My tax. Former employees are listed too.</p>
            </div></div>
        </div>
        <div class="col-lg-6">
            <div class="card h-100"><div class="card-header">Form 24Q — deductee annexure</div><div class="card-body">
                @if (!can24Q)
                {
                    <p class="small text-muted mb-0">The annexure contains full PANs. It needs both payroll-management and sensitive-data permissions.</p>
                }
                else
                {
                    <form method="get" action="/org/payroll/returns/24q" class="row g-2">
                        <div class="col-6"><label class="form-label small" for="qy">Financial year</label>
                            <select id="qy" name="year" class="form-select">@foreach (var y in years) { <option value="@y">@Fy(y)</option> }</select></div>
                        <div class="col-6"><label class="form-label small" for="qq">Quarter</label>
                            <select id="qq" name="quarter" class="form-select"><option value="1">Q1 (Apr–Jun)</option><option value="2">Q2 (Jul–Sep)</option><option value="3">Q3 (Oct–Dec)</option><option value="4">Q4 (Jan–Mar)</option></select></div>
                        <div class="col-12 text-end"><button class="btn btn-accent" type="submit"><i class="bi bi-file-earmark-spreadsheet me-1"></i>Download Excel</button></div>
                    </form>
                    <p class="small text-muted mt-3 mb-0">One row per employee per month (section 192): PAN, amount paid, TDS and dates, ready to key into the Return Preparation Utility. Challan details are added in the RPU.</p>
                }
            </div></div>
        </div>
    </div>
}
