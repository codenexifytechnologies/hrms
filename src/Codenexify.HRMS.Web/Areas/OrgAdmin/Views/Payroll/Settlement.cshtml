@model Codenexify.HRMS.Domain.Payroll.FullAndFinalSettlement
@using Codenexify.HRMS.Domain.Payroll
@{
    ViewData["Title"] = $"Full & final · {Model.Employee.FullName}";
    var manage = User.HasPermission(TenantPermissions.PayrollManage);
    var draft = Model.Status == SettlementStatus.Draft;
    var inr = System.Globalization.CultureInfo.GetCultureInfo("en-IN");
    string M(decimal v) => (v < 0 ? "−₹" : "₹") + Math.Abs(v).ToString("N2", inr);
}
<div class="page-head no-print">
    <div><h1>Full &amp; final settlement</h1>
        <nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/org/payroll/settlements">Full &amp; final</a></li><li class="breadcrumb-item active">@Model.Employee.EmployeeCode</li></ol></nav></div>
    <div class="d-flex gap-2">
        @if (manage && draft)
        {
            <form method="post" action="/org/payroll/settlement/@Model.Id/recalculate" asp-antiforgery="true"><button class="btn btn-light border" type="submit"><i class="bi bi-arrow-repeat me-1"></i>Recalculate</button></form>
            <form method="post" action="/org/payroll/settlement/@Model.Id/approve" asp-antiforgery="true" data-confirm="Approve this settlement? It will be locked."><button class="btn btn-accent" type="submit">Approve</button></form>
        }
        @if (manage && Model.Status == SettlementStatus.Approved)
        {
            <form method="post" action="/org/payroll/settlement/@Model.Id/paid" asp-antiforgery="true" class="d-flex gap-2"><input type="date" name="paidOn" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required aria-label="Paid on" /><button class="btn btn-accent text-nowrap" type="submit">Mark paid</button></form>
        }
        <button class="btn btn-light border" type="button" data-print><i class="bi bi-printer me-1"></i>Print</button>
    </div>
</div>
<div class="card" style="max-width: 860px"><div class="card-body p-4">
    <div class="d-flex justify-content-between flex-wrap gap-2 border-bottom pb-3 mb-3">
        <div><div class="fs-5 fw-bold">@Model.Employee.FullName</div><div class="small text-muted">@Model.Employee.EmployeeCode · joined @Model.Employee.DateOfJoining.ToString("dd MMM yyyy") · last working day @Model.LastWorkingDay.ToString("dd MMM yyyy")</div></div>
        <div class="text-end"><span class="badge-status st-@(draft ? "PendingVerification" : Model.Status == SettlementStatus.Approved ? "Trial" : "Active")">@Model.Status</span>
            @if (Model.ApprovedBy is not null) { <div class="small text-muted">Approved by @Model.ApprovedBy</div> }
            @if (Model.PaidOn is { } p) { <div class="small text-muted">Paid on @p.ToString("dd MMM yyyy")</div> }</div>
    </div>
    <table class="table">
        <thead><tr><th>Item</th><th class="text-end">Amount</th>@if (manage && draft) { <th class="no-print"></th> }</tr></thead>
        <tbody>@foreach (var l in Model.Lines.Where(l => !l.IsDeleted))
        {
            <tr><td>@l.Description @if (l.IsManual) { <span class="badge text-bg-light border">manual</span> }</td><td class="text-end @(l.Amount < 0 ? "text-danger" : "")">@M(l.Amount)</td>
                @if (manage && draft) { <td class="text-end no-print">@if (l.IsManual) { <form method="post" action="/org/payroll/settlement/@Model.Id/line/@l.Id/remove" asp-antiforgery="true"><button class="btn btn-sm btn-link text-danger" type="submit" title="Remove"><i class="bi bi-x-lg"></i></button></form> }</td> }</tr>
        }
        @if (!Model.Lines.Any(l => !l.IsDeleted)) { <tr><td colspan="3" class="text-muted">No items.</td></tr> }</tbody>
        <tfoot>
            <tr><td>Total payable</td><td class="text-end">@M(Model.TotalPayable)</td></tr>
            <tr><td>Total recoverable</td><td class="text-end text-danger">@M(-Model.TotalRecoverable)</td></tr>
            <tr class="fw-bold fs-5"><td>Net @(Model.NetAmount >= 0 ? "payable to employee" : "recoverable from employee")</td><td class="text-end">@M(Model.NetAmount)</td></tr>
        </tfoot>
    </table>
    @if (manage && draft)
    {
        <form method="post" action="/org/payroll/settlement/@Model.Id/line" asp-antiforgery="true" class="row g-2 no-print">
            <div class="col-md-7"><input name="description" class="form-control" placeholder="e.g. Notice pay shortfall, bonus, reimbursement" required maxlength="200" aria-label="Description" /></div>
            <div class="col-md-3"><input name="amount" type="number" step="0.01" class="form-control" placeholder="Amount (− to recover)" required aria-label="Amount" /></div>
            <div class="col-md-2"><button class="btn btn-soft w-100" type="submit">Add item</button></div>
        </form>
    }
</div></div>
