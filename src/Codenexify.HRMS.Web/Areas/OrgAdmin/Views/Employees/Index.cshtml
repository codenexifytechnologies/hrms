@model PagedResult<EmployeeRow>
@{
    ViewData["Title"] = "Employees";
    var q = (EmployeeQuery)ViewBag.Query;
    var branches = (IReadOnlyList<LookupItem>)ViewBag.Branches;
    var departments = (IReadOnlyList<LookupItem>)ViewBag.Departments;
    var designations = (IReadOnlyList<LookupItem>)ViewBag.Designations;
    var canExport = User.HasPermission(TenantPermissions.ReportsView);
    var exportUrl = "/org/employees/export" + Context.Request.QueryString;
}
<div class="page-head">
    <div><h1>Employees</h1><div class="text-muted small">@Model.TotalCount.ToString("N0") employee(s)@(q.Status is null && !q.IncludeExited ? " (current)" : "")</div></div>
    <div class="d-flex gap-2">
        @if (canExport) { <a href="@exportUrl" class="btn btn-light border"><i class="bi bi-file-earmark-excel me-1"></i>Export</a> }
        @if (User.HasPermission(TenantPermissions.EmployeesManage)) { <a href="/org/employees/create" class="btn btn-accent"><i class="bi bi-person-plus me-1"></i>Add employee</a> }
    </div>
</div>
<div class="card">
    <div class="card-header">
        <form method="get" class="row g-2 w-100">
            <div class="col-lg-3"><input type="search" name="search" value="@q.Search" class="form-control" placeholder="Name, ID, email or phone" aria-label="Search" /></div>
            <div class="col-6 col-lg-2"><select name="departmentId" class="form-select" data-autosubmit aria-label="Department"><option value="">All departments</option>
                @foreach (var d in departments) { <option value="@d.Id" selected="@(q.DepartmentId == d.Id)">@d.Name</option> }</select></div>
            <div class="col-6 col-lg-2"><select name="branchId" class="form-select" data-autosubmit aria-label="Branch"><option value="">All branches</option>
                @foreach (var b in branches) { <option value="@b.Id" selected="@(q.BranchId == b.Id)">@b.Name</option> }</select></div>
            <div class="col-6 col-lg-2"><select name="designationId" class="form-select" data-autosubmit aria-label="Designation"><option value="">All designations</option>
                @foreach (var d in designations) { <option value="@d.Id" selected="@(q.DesignationId == d.Id)">@d.Name</option> }</select></div>
            <div class="col-6 col-lg-2"><select name="status" class="form-select" data-autosubmit aria-label="Status"><option value="">Current employees</option>
                @foreach (var s in Enum.GetValues<EmployeeStatus>()) { <option value="@s" selected="@(q.Status == s)">@s</option> }</select></div>
            <div class="col-lg-1"><button class="btn btn-light border w-100" type="submit">Filter</button></div>
        </form>
    </div>
    @if (Model.Items.Count == 0)
    {
        <div class="empty-state"><i class="bi bi-person-vcard"></i>No employees found.
            @if (User.HasPermission(TenantPermissions.EmployeesManage) && Model.TotalCount == 0 && string.IsNullOrEmpty(q.Search)) { <div class="mt-3"><a href="/org/employees/create" class="btn btn-accent">Add your first employee</a></div> }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead><tr><th>Employee</th><th>Department</th><th>Designation</th><th>Reports to</th><th>Joined</th><th>Status</th></tr></thead>
                <tbody>
                @foreach (var e in Model.Items)
                {
                    <tr>
                        <td><a href="/org/employees/details/@e.Id" class="fw-semibold">@e.Name</a>
                            <div class="small text-muted">@e.Code · @e.WorkEmail @if (!e.HasLogin) { <span class="badge text-bg-light border ms-1" title="No login">no login</span> }</div></td>
                        <td class="small">@(e.Department ?? "—")<div class="text-muted">@e.Branch</div></td>
                        <td class="small">@(e.Designation ?? "—")</td>
                        <td class="small">@(e.Manager ?? "—")</td>
                        <td class="small text-nowrap">@e.DateOfJoining.ToString("dd MMM yyyy")</td>
                        <td><span class="badge-status st-@e.Status">@e.Status</span></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    <partial name="_Pager" model="Model.ToPager()" />
</div>
