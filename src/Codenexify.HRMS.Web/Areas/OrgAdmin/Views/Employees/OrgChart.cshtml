@model IReadOnlyList<OrgChartNode>
@{
    ViewData["Title"] = "Org chart";
}
<div class="page-head">
    <div><h1>Organization chart</h1><div class="text-muted small">Reporting lines of current employees. People without a manager appear at the top level.</div></div>
</div>
<div class="card"><div class="card-body org-tree">
    @if (Model.Count == 0) { <div class="empty-state"><i class="bi bi-diagram-3"></i>No employees yet.</div> }
    else { <ul>@foreach (var n in Model) { <partial name="_OrgNode" model="n" /> }</ul> }
</div></div>
