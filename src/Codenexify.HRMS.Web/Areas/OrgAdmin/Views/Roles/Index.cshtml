@model IReadOnlyList<RoleRow>
@{
    ViewData["Title"] = "Roles & permissions";
    var canCreate = (bool)ViewBag.CanCreate;
}
<div class="page-head">
    <div><h1>Roles &amp; permissions</h1><div class="text-muted small">Control what each group of users can see and do</div></div>
    @if (canCreate) { <a href="/org/roles/create" class="btn btn-accent"><i class="bi bi-plus-lg me-1"></i>New role</a> }
    else { <span class="small text-muted"><i class="bi bi-lock me-1"></i>Custom roles are available on the Strength plan and above.</span> }
</div>
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover">
            <thead><tr><th>Role</th><th class="text-end">Permissions</th><th class="text-end">Users</th><th></th></tr></thead>
            <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td><div class="fw-semibold">@r.Name @if (r.IsSystem) { <span class="badge text-bg-light border ms-1">System</span> }</div><div class="small text-muted">@r.Description</div></td>
                    <td class="text-end">@r.PermissionCount</td>
                    <td class="text-end">@r.UserCount</td>
                    <td class="text-end text-nowrap">
                        <a href="/org/roles/edit/@r.Id" class="btn btn-sm btn-soft">@(r.IsSystem && r.Name == TenantPermissions.OrgAdminRole ? "View" : "Edit")</a>
                        @if (canCreate && !(r.IsSystem && r.Name == TenantPermissions.OrgAdminRole)) { <a href="/org/roles/create?from=@r.Id" class="btn btn-sm btn-light border" title="Duplicate"><i class="bi bi-copy"></i></a> }
                        @if (!r.IsSystem)
                        {
                            <form method="post" action="/org/roles/delete/@r.Id" asp-antiforgery="true" class="d-inline" data-confirm="Delete role @r.Name?" data-confirm-danger="1">
                                <button class="btn btn-sm btn-outline-danger" type="submit" title="Delete"><i class="bi bi-trash"></i></button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
