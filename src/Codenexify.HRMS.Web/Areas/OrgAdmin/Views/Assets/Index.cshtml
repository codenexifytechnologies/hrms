@model Codenexify.HRMS.Application.Common.PagedResult<Codenexify.HRMS.Application.Strength.AssetRow>
@using Codenexify.HRMS.Application.Strength
@using Codenexify.HRMS.Domain.Strength
@{
    ViewData["Title"] = "Assets";
    var q = (AssetQuery)ViewBag.Query;
    var categories = (IReadOnlyList<string>)ViewBag.Categories;
    string Css(AssetStatus s) => s switch { AssetStatus.Available => "Active", AssetStatus.Assigned => "Issued", AssetStatus.UnderRepair => "PendingVerification", AssetStatus.Lost => "Expired", _ => "Inactive" };
}
<div class="page-head"><div><h1>Assets</h1><div class="text-muted small">Company equipment and who holds it</div></div>
    <a class="btn btn-accent" href="/org/assets/edit"><i class="bi bi-plus-lg me-1"></i>Add asset</a></div>
<div class="card">
    <div class="card-body border-bottom">
        <form method="get" action="/org/assets" class="row g-2 align-items-end">
            <div class="col-md-4"><label class="form-label small" for="as">Search</label><input id="as" name="search" value="@q.Search" class="form-control" placeholder="Tag, name, serial or holder" /></div>
            <div class="col-md-3"><label class="form-label small" for="ac">Category</label>
                <select id="ac" name="category" class="form-select"><option value="">All</option>@foreach (var c in categories) { <option selected="@(c == q.Category)">@c</option> }</select></div>
            <div class="col-md-3"><label class="form-label small" for="ast">Status</label>
                <select id="ast" name="status" class="form-select"><option value="">All</option>@foreach (var s in Enum.GetValues<AssetStatus>()) { <option value="@s" selected="@(q.Status == s)">@s</option> }</select></div>
            <div class="col-md-2"><button class="btn btn-soft w-100" type="submit">Filter</button></div>
        </form>
    </div>
    @if (Model.Items.Count == 0) { <div class="empty-state"><i class="bi bi-laptop"></i>No assets yet.</div> }
    else
    {
        <div class="table-responsive"><table class="table table-hover mb-0 align-middle">
            <thead><tr><th>Tag</th><th>Asset</th><th>Holder</th><th>Status</th><th>Warranty</th></tr></thead>
            <tbody>@foreach (var a in Model.Items)
            {
                <tr><td><a class="fw-semibold" href="/org/assets/edit/@a.Id"><code>@a.AssetTag</code></a></td>
                    <td>@a.Name<div class="small text-muted">@a.Category@(a.SerialNumber is null ? "" : $" · S/N {a.SerialNumber}") · @a.Condition</div></td>
                    <td class="small">@if (a.EmployeeName is not null) { <span>@a.EmployeeName</span><div class="text-muted">since @a.AssignedOn?.ToString("dd MMM yyyy")@(a.Acknowledged ? "" : " · not confirmed yet")</div> } else { <span class="text-muted">—</span> }</td>
                    <td><span class="badge-status st-@Css(a.Status)">@a.Status</span></td>
                    <td class="small @(a.WarrantyUntil is { } w && w < DateOnly.FromDateTime(DateTime.Today) ? "text-danger" : "")">@(a.WarrantyUntil?.ToString("dd MMM yyyy") ?? "—")</td></tr>
            }</tbody>
        </table></div>
    }
    <partial name="_Pager" model="Model.ToPager()" />
</div>
