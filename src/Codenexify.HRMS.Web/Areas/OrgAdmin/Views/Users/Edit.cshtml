@model TenantUserInput
@{
    var id = ViewBag.Id as int?;
    var isNew = id is null;
    ViewData["Title"] = isNew ? "Add user" : "Edit user";
    var roles = (IReadOnlyList<RoleRow>)ViewBag.Roles;
}
<div class="page-head">
    <div><h1>@ViewData["Title"]</h1>
        <nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/org/users">Users</a></li><li class="breadcrumb-item active">@(isNew ? "New" : Model.FullName)</li></ol></nav></div>
</div>
<form method="post" action="@(isNew ? "/org/users/create" : $"/org/users/edit/{id}")" asp-antiforgery="true" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
    <div class="row g-3">
        <div class="col-lg-6">
            <div class="card"><div class="card-header">Account</div><div class="card-body row g-3">
                <div class="col-12"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control" /><span asp-validation-for="FullName"></span></div>
                <div class="col-md-7"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email"></span></div>
                <div class="col-md-5"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control" /><span asp-validation-for="Phone"></span></div>
                <div class="col-12"><label asp-for="Password" class="form-label">@(isNew ? "Initial password" : "Reset password (leave blank to keep)")</label>
                    <input asp-for="Password" class="form-control" autocomplete="new-password" /><div class="form-text">At least 8 characters. The user must change it at next sign-in.</div><span asp-validation-for="Password"></span></div>
                <div class="col-12"><div class="form-check form-switch"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div></div>
            </div></div>
        </div>
        <div class="col-lg-6">
            <div class="card"><div class="card-header">Roles</div><div class="card-body">
                @foreach (var r in roles)
                {
                    <label class="feature-pill mb-2">
                        <span class="small"><strong>@r.Name</strong>@if (r.IsSystem) { <span class="badge text-bg-light border ms-1">System</span> }<br /><span class="text-muted">@(r.Description ?? $"{r.PermissionCount} permission(s)")</span></span>
                        <input type="checkbox" class="form-check-input m-0" name="RoleIds" value="@r.Id" checked="@Model.RoleIds.Contains(r.Id)" />
                    </label>
                }
            </div></div>
        </div>
    </div>
    <div class="d-flex gap-2 justify-content-end mt-3">
        <a href="/org/users" class="btn btn-light border">Cancel</a>
        <button type="submit" class="btn btn-accent">@(isNew ? "Add user" : "Save user")</button>
    </div>
</form>
