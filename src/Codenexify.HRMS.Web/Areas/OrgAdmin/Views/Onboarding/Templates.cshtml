@model IReadOnlyList<Codenexify.HRMS.Application.Strength.OnboardingTemplateRow>
@{ ViewData["Title"] = "Onboarding templates"; }
<div class="page-head"><div><h1>Onboarding templates</h1>
    <nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/org/onboarding">Onboarding</a></li><li class="breadcrumb-item active">Templates</li></ol></nav></div>
    <a class="btn btn-accent" href="/org/onboarding/templates/edit"><i class="bi bi-plus-lg me-1"></i>New template</a></div>
<div class="card">
    @if (Model.Count == 0) { <div class="empty-state"><i class="bi bi-list-check"></i>No templates yet.</div> }
    else
    {
        <div class="table-responsive"><table class="table table-hover mb-0 align-middle">
            <thead><tr><th>Template</th><th>Tasks</th><th>Status</th><th></th></tr></thead>
            <tbody>@foreach (var t in Model)
            {
                <tr><td><a class="fw-semibold" href="/org/onboarding/templates/edit/@t.Id">@t.Name</a><div class="small text-muted">@t.Description</div></td>
                    <td>@t.TaskCount</td><td>@(t.IsActive ? "Active" : "Inactive")</td>
                    <td class="text-end"><form method="post" action="/org/onboarding/templates/@t.Id/delete" asp-antiforgery="true">
                        <button class="btn btn-sm btn-outline-danger" type="submit" title="Delete" data-confirm="Delete template @t.Name?" data-confirm-danger="1"><i class="bi bi-trash"></i></button></form></td></tr>
            }</tbody>
        </table></div>
    }
</div>
