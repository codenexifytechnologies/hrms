@model IReadOnlyList<PlanSummary>
@{
    ViewData["Title"] = "Plans";
    var canManage = User.HasPermission(PlatformPermissions.PlansManage);
}
<div class="page-head">
    <div><h1>Subscription plans</h1><div class="text-muted small">Plans inherit every feature of their parent plan.</div></div>
    @if (canManage) { <a href="/superadmin/plans/create" class="btn btn-accent"><i class="bi bi-plus-lg me-1"></i>New plan</a> }
</div>
@if (Model.Count == 0)
{
    <div class="card"><div class="empty-state"><i class="bi bi-layers"></i>No plans yet.</div></div>
}
<div class="row g-3">
    @foreach (var p in Model)
    {
        <div class="col-md-6 col-xl-3">
            <div class="card h-100">
                <div class="card-header">
                    <span>@p.Name <code class="small ms-1">@p.Code</code></span>
                    <span class="badge-status st-@(p.IsActive ? "Active" : "Inactive")">@(p.IsActive ? "Active" : "Inactive")</span>
                </div>
                <div class="card-body d-flex flex-column">
                    <div class="plan-price fs-3">₹@p.MonthlyPrice.ToString("N0")<span class="fs-6 text-muted fw-normal">@(p.IsPerEmployeePricing ? "/emp" : "")/mo</span></div>
                    <div class="small text-muted mb-3">₹@p.YearlyPrice.ToString("N0") yearly · @p.TrialDays-day trial</div>
                    <ul class="list-unstyled small flex-grow-1 mb-3">
                        <li><i class="bi bi-diagram-3 me-2 text-muted"></i>@(p.ParentName is null ? "Base plan" : "Includes " + p.ParentName)</li>
                        <li><i class="bi bi-puzzle me-2 text-muted"></i>@p.EffectiveFeatureCount features (@p.OwnFeatureCount own)</li>
                        <li><i class="bi bi-people me-2 text-muted"></i>@p.MaxEmployees.ToString("N0") employees · @p.MaxBranches branches</li>
                        <li><i class="bi bi-hdd me-2 text-muted"></i>@p.StorageLimitGb GB storage</li>
                        <li><i class="bi bi-building-check me-2 text-muted"></i>@p.ActiveSubscriptions active subscription(s)</li>
                        <li><i class="bi bi-eye me-2 text-muted"></i>@(p.IsCustom ? "Custom / enterprise" : p.IsPublic ? "Public" : "Hidden")</li>
                    </ul>
                    @if (canManage)
                    {
                        <div class="d-flex gap-2">
                            <a href="/superadmin/plans/edit/@p.Id" class="btn btn-sm btn-soft flex-grow-1">Edit</a>
                            <form asp-antiforgery="true" method="post" action="/superadmin/plans/delete/@p.Id" data-confirm="Delete plan @p.Name? Only plans that were never subscribed can be deleted." data-confirm-danger>
                                <button class="btn btn-sm btn-outline-danger" type="submit" title="Delete"><i class="bi bi-trash"></i></button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>
