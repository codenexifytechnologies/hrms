@model Codenexify.HRMS.Application.Support.AnnouncementInput
@using Codenexify.HRMS.Domain.Support
@{
    var id = ViewBag.Id as int?;
    ViewData["Title"] = id is null ? "New announcement" : "Edit announcement";
    var plans = (List<SelectListItem>)ViewBag.Plans;
}
<div class="page-head"><div><h1>@ViewData["Title"]</h1>
    <nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/superadmin/announcements">Announcements</a></li><li class="breadcrumb-item active">@ViewData["Title"]</li></ol></nav></div></div>
<div class="card" style="max-width: 820px"><div class="card-body">
    <form method="post" action="/superadmin/announcements/edit/@id" asp-antiforgery="true" class="row g-3" novalidate>
        <div asp-validation-summary="All" class="alert alert-danger py-2 small col-12"></div>
        <div class="col-md-8"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="Severity" class="form-label"></label>
            <select asp-for="Severity" class="form-select" asp-items="Html.GetEnumSelectList<AnnouncementSeverity>()"></select></div>
        <div class="col-12"><label asp-for="Body" class="form-label">Message</label><textarea asp-for="Body" rows="3" class="form-control"></textarea></div>
        <div class="col-md-4"><label asp-for="PlanId" class="form-label"></label>
            <select asp-for="PlanId" class="form-select"><option value="">All organizations</option>@foreach (var p in plans) { <option value="@p.Value" selected="@(p.Value == Model.PlanId?.ToString())">@p.Text plan only</option> }</select></div>
        <div class="col-md-4"><label asp-for="StartsAt" class="form-label">Show from (IST)</label><input asp-for="StartsAt" type="datetime-local" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="EndsAt" class="form-label">Show until (IST, optional)</label><input asp-for="EndsAt" type="datetime-local" class="form-control" /></div>
        <div class="col-md-4"><div class="form-check form-switch"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div></div>
        <div class="col-md-8"><div class="form-check form-switch"><input asp-for="Dismissible" class="form-check-input" /><label asp-for="Dismissible" class="form-check-label"></label></div>
            <div class="form-text">Critical announcements can never be dismissed.</div></div>
        <div class="col-12 d-flex justify-content-end gap-2"><a href="/superadmin/announcements" class="btn btn-light border">Cancel</a><button class="btn btn-accent" type="submit">Save</button></div>
    </form>
</div></div>
