@using System.Security.Claims
@{
    bool Can(string p) => User.HasPermission(p);
    var name = User.Identity?.Name ?? "";
    var initials = string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(s => s[0]));
}
<!DOCTYPE html>
<html lang="en">
<head>
    <partial name="_Head" />
    <title>@ViewData["Title"] · Control Center</title>
</head>
<body class="portal-platform">
<div class="app-shell">
    <aside class="app-sidebar">
        <a class="app-brand" href="/superadmin">
            <span class="logo logo-mark"><partial name="_BrandMark" /></span>
            <span class="lh-sm"><span class="brand-word">Code<b>nexify</b></span><small>Control Center</small></span>
        </a>
        <nav class="app-nav">
            @if (Can(PlatformPermissions.DashboardView))
            {
                <a href="/superadmin/dashboard" data-nav-match="/superadmin"><i class="bi bi-grid-1x2"></i><span>Dashboard</span></a>
            }
            @if (Can(PlatformPermissions.OrganizationsView))
            {
                <div class="nav-section">Customers</div>
                <a href="/superadmin/organizations"><i class="bi bi-buildings"></i><span>Organizations</span></a>
            }
            @if (Can(PlatformPermissions.BillingManage))
            {
                <div class="nav-section">Billing</div>
                <a href="/superadmin/billing"><i class="bi bi-graph-up-arrow"></i><span>Revenue</span></a>
                <a href="/superadmin/billing/invoices"><i class="bi bi-receipt-cutoff"></i><span>Invoices</span></a>
                @if (Can(PlatformPermissions.SettingsManage))
                {
                    <a href="/superadmin/billing/settings"><i class="bi bi-sliders"></i><span>Billing &amp; email settings</span></a>
                }
            }
            @if (Can(PlatformPermissions.SupportManage) || Can(PlatformPermissions.SupportAccess))
            {
                <div class="nav-section">Support</div>
                @if (Can(PlatformPermissions.SupportManage))
                {
                    <a href="/superadmin/support"><i class="bi bi-life-preserver"></i><span>Tickets</span></a>
                    <a href="/superadmin/announcements"><i class="bi bi-megaphone"></i><span>Announcements</span></a>
                }
                @if (Can(PlatformPermissions.SupportAccess))
                {
                    <a href="/superadmin/support/access"><i class="bi bi-eye"></i><span>Support access</span></a>
                }
            }
            @if (Can(PlatformPermissions.PlansView))
            {
                <div class="nav-section">Catalog</div>
                <a href="/superadmin/plans"><i class="bi bi-layers"></i><span>Plans</span></a>
                <a href="/superadmin/features"><i class="bi bi-toggles"></i><span>Features &amp; modules</span></a>
            }
            @if (Can(PlatformPermissions.StatutoryManage))
            {
                <a href="/superadmin/statutory"><i class="bi bi-bank"></i><span>Statutory rules</span></a>
            }
            @if (Can(PlatformPermissions.UsersManage) || Can(PlatformPermissions.AuditView) || Can(PlatformPermissions.SettingsManage))
            {
                <div class="nav-section">Administration</div>
                @if (Can(PlatformPermissions.SettingsManage))
                {
                    <a href="/superadmin/system"><i class="bi bi-cone-striped"></i><span>System &amp; maintenance</span></a>
                    <a href="/superadmin/legal"><i class="bi bi-file-earmark-text"></i><span>Legal pages</span></a>
                }
                @if (Can(PlatformPermissions.UsersManage))
                {
                    <a href="/superadmin/users"><i class="bi bi-person-badge"></i><span>Platform users</span></a>
                }
                @if (Can(PlatformPermissions.AuditView))
                {
                    <a href="/superadmin/audit"><i class="bi bi-journal-text"></i><span>Audit trail</span></a>
                    <a href="/superadmin/audit/logins"><i class="bi bi-door-open"></i><span>Login history</span></a>
                }
            }
            <div class="nav-section">My account</div>
            <a href="/superadmin/account/security"><i class="bi bi-shield-check"></i><span>Security &amp; 2FA</span></a>
        </nav>
        <div class="app-sidebar-footer">&copy; @DateTime.UtcNow.Year <partial name="_CompanyLink" /></div>
    </aside>
    @* Runs before the page content is drawn: highlights the current menu item and restores the menu's scroll position. *@
    <script src="~/js/nav.js" asp-append-version="true"></script>
    <div class="app-backdrop"></div>
    <div class="app-main">
        <header class="app-header">
            <button class="icon-btn" type="button" data-toggle-sidebar aria-label="Toggle navigation"><i class="bi bi-list"></i></button>
            <span class="badge rounded-pill text-bg-dark d-none d-sm-inline"><i class="bi bi-shield-lock me-1"></i>Platform owner</span>
            <div class="ms-auto d-flex align-items-center gap-2">
                <button class="icon-btn" type="button" data-toggle-theme aria-label="Toggle theme"><i data-theme-icon class="bi bi-moon-stars"></i></button>
                <div class="dropdown">
                    <button class="btn d-flex align-items-center gap-2 border-0" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="avatar">@initials</span>
                        <span class="d-none d-md-block text-start lh-sm small"><strong>@name</strong><br /><span class="text-muted">@User.FindFirstValue(ClaimTypes.Role)</span></span>
                        <i class="bi bi-chevron-down small"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                        <li><a class="dropdown-item" href="/superadmin/account/security"><i class="bi bi-shield-check me-2"></i>Security &amp; 2FA</a></li>
                        <li><a class="dropdown-item" href="/superadmin/account/changepassword"><i class="bi bi-key me-2"></i>Change password</a></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <form asp-antiforgery="true" method="post" action="/superadmin/account/logout">
                                <button class="dropdown-item text-danger" type="submit"><i class="bi bi-box-arrow-right me-2"></i>Sign out</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>
        <main class="app-content fade-in">
            @RenderBody()
        </main>
    </div>
</div>
<partial name="_Scripts" />
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
