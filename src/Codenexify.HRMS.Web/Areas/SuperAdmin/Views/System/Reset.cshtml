@using Codenexify.HRMS.Application.Support
@model DataResetInput
@{
    ViewData["Title"] = "Reset all data";
    var s = (DataResetStatus)ViewBag.Status;
    var canRun = s.Enabled && s.IsSuperAdmin;
}
<div class="page-head">
    <div><h1>Reset all data</h1><div class="text-muted small"><a href="/superadmin/system">System &amp; maintenance</a> / Danger zone</div></div>
</div>

<div style="max-width: 820px">
    @if (!s.Enabled)
    {
        <div class="alert alert-secondary"><i class="bi bi-lock me-1"></i><strong>Switched off on this server.</strong>
            To allow it, set <code>"@DataResetRules.EnabledSetting.Replace(":", "\": { \"")": true }</code> in the settings file and restart. It is off by default on live servers.</div>
    }
    else if (!s.IsSuperAdmin)
    {
        <div class="alert alert-secondary"><i class="bi bi-lock me-1"></i>Only a <strong>Super Admin</strong> can reset all data.</div>
    }

    <div class="card border-danger mb-3">
        <div class="card-header text-danger"><i class="bi bi-exclamation-octagon me-1"></i>This permanently deletes every company</div>
        <div class="card-body">
            <div class="row g-3 mb-3 text-center">
                <div class="col-6 col-md-3"><div class="border rounded p-2"><div class="fs-4 fw-semibold">@s.Organizations</div><div class="small text-muted">Companies</div></div></div>
                <div class="col-6 col-md-3"><div class="border rounded p-2"><div class="fs-4 fw-semibold">@s.TenantUsers</div><div class="small text-muted">Company logins</div></div></div>
                <div class="col-6 col-md-3"><div class="border rounded p-2"><div class="fs-4 fw-semibold">@s.Employees</div><div class="small text-muted">Employees</div></div></div>
                <div class="col-6 col-md-3"><div class="border rounded p-2"><div class="fs-4 fw-semibold">@s.UploadedFiles</div><div class="small text-muted">Uploaded files</div></div></div>
            </div>
            <div class="row g-3 small">
                <div class="col-md-6">
                    <div class="fw-semibold text-danger mb-1">Deleted</div>
                    <ul class="mb-0 ps-3">
                        <li>All companies and their subscriptions, invoices and payments</li>
                        <li>Company admin and employee logins</li>
                        <li>Employees, attendance, leave, payroll, documents and every other company record</li>
                        <li>Support tickets, audit log and login history</li>
                    </ul>
                </div>
                <div class="col-md-6">
                    <div class="fw-semibold text-success mb-1">Kept</div>
                    <ul class="mb-0 ps-3">
                        <li>Control Center users, their passwords and permissions</li>
                        <li>Plans, prices and modules</li>
                        <li>Statutory rates (PF, ESI, PT, LWF, income tax)</li>
                        <li>Control Center settings and announcements</li>
                    </ul>
                </div>
            </div>
            <hr />
            <div class="small text-muted">
                @if (s.BackupSupported)
                {
                    <div><i class="bi bi-database-check me-1"></i>A full database backup is taken and verified first. If the backup fails, nothing is deleted.</div>
                }
                <div><i class="bi bi-folder-symlink me-1"></i>Uploaded files are moved to a separate folder, not deleted.</div>
                <div><i class="bi bi-arrow-repeat me-1"></i>New companies, users and records start again from number 1.</div>
            </div>
        </div>
    </div>

    <form method="post" action="/superadmin/system/reset" asp-antiforgery="true" novalidate autocomplete="off">
        <div asp-validation-summary="All" class="alert alert-danger py-2 small"></div>
        <fieldset @(canRun ? "" : "disabled")>
            <div class="card mb-3"><div class="card-header">Confirm</div><div class="card-body row g-3">
                <div class="col-12">
                    <label asp-for="Confirmation" class="form-label">Type <code class="user-select-all">@DataResetRules.ConfirmationPhrase</code> to confirm</label>
                    <input asp-for="Confirmation" class="form-control font-monospace" autocomplete="off" spellcheck="false" />
                    <span asp-validation-for="Confirmation" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                @if (s.TwoFactorRequired)
                {
                    <div class="col-md-6">
                        <label asp-for="TotpCode" class="form-label"></label>
                        <input asp-for="TotpCode" class="form-control" inputmode="numeric" autocomplete="one-time-code" maxlength="10" />
                    </div>
                }
            </div></div>
            <div class="d-flex justify-content-between align-items-center">
                <a class="btn btn-outline-secondary" href="/superadmin/system">Cancel</a>
                <button class="btn btn-danger" type="submit"><i class="bi bi-trash3 me-1"></i>Delete all company data</button>
            </div>
        </fieldset>
    </form>
</div>
