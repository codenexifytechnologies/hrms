@model PlatformLoginViewModel
@{
    ViewData["Title"] = "Control Center sign in";
    ViewData["HideNav"] = true;
    ViewData["BodyClass"] = "portal-platform";
    ViewData["AuthMode"] = "platform";
    Layout = "_PublicLayout";
}
@section Styles { <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" /> }
<div class="ax-wrap">
    <partial name="_AuthAside" />
    <div class="ax-panel">
        <div class="ax-card">
            <span class="ax-eyebrow">Control Center</span>
            <h1 class="ax-title">Staff sign in</h1>
            <p class="ax-sub">Super Admin, Support, Finance and Sales staff. All activity is recorded.</p>
            <form method="post" action="/superadmin/account/login" asp-antiforgery="true" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
                <input type="hidden" asp-for="ReturnUrl" />
                <div class="ax-field">
                    <label asp-for="Email" class="form-label"></label>
                    <div class="ax-input"><i class="bi bi-envelope"></i><input asp-for="Email" class="form-control" autocomplete="username" autofocus /></div>
                    <span asp-validation-for="Email" class="small"></span>
                </div>
                <div class="ax-field">
                    <label asp-for="Password" class="form-label"></label>
                    <div class="ax-input"><i class="bi bi-lock"></i><input asp-for="Password" class="form-control" autocomplete="current-password" />
                        <button type="button" class="ax-eye" data-ax-eye aria-label="Show password" aria-pressed="false"><i class="bi bi-eye"></i></button></div>
                    <span asp-validation-for="Password" class="small"></span>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check mb-0">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label"></label>
                    </div>
                    <a class="small fw-semibold" href="/superadmin/account/forgot-password">Forgot password?</a>
                </div>
                <button type="submit" class="btn ax-submit w-100"><i class="bi bi-shield-lock me-2"></i>Sign in</button>
            </form>
            <p class="ax-foot-note"><i class="bi bi-info-circle me-1"></i>Client companies sign in at <a href="/login">the company sign-in page</a>.</p>
        </div>
    </div>
</div>
@section Scripts { <script src="~/js/auth.js" asp-append-version="true"></script> }
