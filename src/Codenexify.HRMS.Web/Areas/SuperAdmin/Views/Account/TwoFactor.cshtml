@model TwoFactorViewModel
@{
    ViewData["Title"] = "Two-factor authentication";
    ViewData["HideNav"] = true;
    ViewData["BodyClass"] = "portal-platform";
    Layout = "_PublicLayout";
}
<div class="auth-panel min-vh-100">
    <div class="auth-card card p-4">
        <div class="kpi mb-3"><div class="kpi-icon"><i class="bi bi-phone"></i></div>
            <div><h4 class="fw-bold mb-0">Verify it's you</h4><div class="small text-muted">Enter the 6-digit code from your authenticator app.</div></div>
        </div>
        <form method="post" action="/superadmin/account/twofactor" asp-antiforgery="true" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
            <input type="hidden" asp-for="ReturnUrl" />
            <input asp-for="Code" class="form-control form-control-lg text-center fw-bold" inputmode="numeric" autocomplete="one-time-code" autofocus placeholder="123456" />
            <span asp-validation-for="Code"></span>
            <button type="submit" class="btn btn-accent w-100 mt-3">Verify</button>
        </form>
        <a href="/superadmin/account/login" class="small text-center mt-3">Back to sign in</a>
    </div>
</div>
