@using Codenexify.HRMS.Application.Support
@model IReadOnlyList<LegalPageRow>
@{
    ViewData["Title"] = "Legal pages";
    var missing = (IReadOnlyList<(string Placeholder, string WhereToSet)>)ViewBag.Missing;
    var settings = (LegalSettingsInput)ViewBag.Settings;
    var unreviewed = Model.Count(p => !p.IsReviewed);
}
<div class="page-head"><div><h1>Legal pages</h1><div class="text-muted small">Privacy policy, terms, refund policy and contact page shown on the public website</div></div></div>

<div style="max-width: 980px">
    @if (unreviewed > 0)
    {
        <div class="alert alert-warning d-flex gap-2"><i class="bi bi-exclamation-triangle"></i><div>
            <strong>@unreviewed page(s) are starter drafts.</strong> They describe how the product works, but they are not legal advice.
            Have your lawyer review each page, edit it here, then tick <em>Reviewed by our lawyer</em>.</div></div>
    }
    @if (missing.Count > 0)
    {
        <div class="alert alert-info"><div class="fw-semibold mb-1"><i class="bi bi-info-circle me-1"></i>These details are missing, so the pages print "@LegalPageService.Missing":</div>
            <ul class="mb-0 small">
                @foreach (var m in missing) { <li><code>@m.Placeholder</code>: set it in @m.WhereToSet</li> }
            </ul></div>
    }

    <div class="card mb-3">
        <div class="table-responsive"><table class="table align-middle mb-0">
            <thead><tr><th>Page</th><th>Address</th><th>Version</th><th>Effective from</th><th>Status</th><th>Last edited</th><th></th></tr></thead>
            <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td class="fw-semibold">@p.Title</td>
                    <td><a href="/@p.Slug" target="_blank" rel="noopener">/@p.Slug <i class="bi bi-box-arrow-up-right small"></i></a></td>
                    <td>v@(p.Version)</td>
                    <td>@p.EffectiveOn.ToString("dd MMM yyyy")</td>
                    <td>
                        @if (p.IsPublished) { <span class="badge text-bg-success">Published</span> } else { <span class="badge text-bg-secondary">Hidden</span> }
                        @if (p.IsReviewed) { <span class="badge text-bg-primary">Reviewed</span> } else { <span class="badge text-bg-warning">Draft: not reviewed</span> }
                    </td>
                    <td class="small text-muted">@(p.UpdatedAtUtc is { } u ? $"{u.ToLocalTime():dd MMM yyyy} · {p.UpdatedBy}" : "Not edited yet")</td>
                    <td class="text-end"><a class="btn btn-sm btn-outline-secondary" href="/superadmin/legal/@p.Id"><i class="bi bi-pencil me-1"></i>Edit</a></td>
                </tr>
            }
            </tbody>
        </table></div>
    </div>

    <form method="post" action="/superadmin/legal/settings" asp-antiforgery="true" novalidate class="card">
        <div class="card-header">Details printed on the pages</div>
        <div class="card-body row g-3">
            <div class="col-md-4"><label class="form-label" for="GrievanceOfficerName">Grievance Officer name</label>
                <input class="form-control" id="GrievanceOfficerName" name="GrievanceOfficerName" value="@settings.GrievanceOfficerName" maxlength="150" /></div>
            <div class="col-md-4"><label class="form-label" for="GrievanceOfficerEmail">Grievance Officer email</label>
                <input class="form-control" type="email" id="GrievanceOfficerEmail" name="GrievanceOfficerEmail" value="@settings.GrievanceOfficerEmail" maxlength="200" placeholder="grievance@your-domain" /></div>
            <div class="col-md-4"><label class="form-label" for="LegalJurisdictionCity">Courts at (city)</label>
                <input class="form-control" id="LegalJurisdictionCity" name="LegalJurisdictionCity" value="@settings.LegalJurisdictionCity" maxlength="100" placeholder="e.g. Pune" /></div>
            <div class="col-12 form-text">Company name, address, GSTIN, phone and billing email come from <a href="/superadmin/billing/settings">Billing &amp; email settings</a>; the support email from <a href="/superadmin/system">System &amp; maintenance</a>.</div>
        </div>
        <div class="card-footer d-flex justify-content-end"><button class="btn btn-accent" type="submit">Save details</button></div>
    </form>
</div>
