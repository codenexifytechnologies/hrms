@{
    var code = ViewData["Code"] as int? ?? 500;
    ViewData["Title"] = code == 404 ? "Page not found" : code == 403 ? "Access denied" : "Something went wrong";
    var message = code switch
    {
        404 => "The page you are looking for does not exist or has been moved.",
        403 => "You do not have permission to view this page.",
        429 => "Too many requests. Please wait a moment and try again.",
        _ => "An unexpected error occurred. Our team has been notified."
    };
}
<div class="container py-5">
    <div class="empty-state">
        <i class="bi bi-exclamation-octagon"></i>
        <h1 class="display-5 fw-bold">@code</h1>
        <h4>@ViewData["Title"]</h4>
        <p class="text-muted">@message</p>
        <a href="/" class="btn btn-accent mt-2">Go to home</a>
    </div>
</div>
