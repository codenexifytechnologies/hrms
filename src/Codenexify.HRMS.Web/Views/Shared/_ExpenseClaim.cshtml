@model Codenexify.HRMS.Application.Payroll.ExpenseClaimView
@using Codenexify.HRMS.Domain.Payroll
@{
    var c = Model.Claim;
    var receiptBase = (string)ViewData["ReceiptBase"]!;
    var inr = System.Globalization.CultureInfo.GetCultureInfo("en-IN");
    string Money(decimal v) => "₹" + v.ToString("N2", inr);
}
<div class="card mb-3"><div class="card-body row g-3 small">
    <div class="col-sm-4"><div class="text-muted">Employee</div><div class="fw-semibold">@c.EmployeeName <span class="text-muted fw-normal">(@c.EmployeeCode)</span></div></div>
    <div class="col-sm-3"><div class="text-muted">Submitted</div><div class="fw-semibold">@c.SubmittedAtUtc.ToLocalTime().ToString("dd MMM yyyy")</div></div>
    <div class="col-sm-2"><div class="text-muted">Total</div><div class="fw-semibold fs-6">@Money(c.Total)</div></div>
    <div class="col-sm-3"><div class="text-muted">Status</div><div><span class="badge-status st-@(ExpenseStatusCss(c.Status))">@ExpenseStatusText(c.Status)</span></div></div>
    @if (c.ManagerDecisionBy is not null) { <div class="col-sm-4"><div class="text-muted">Manager review</div><div>@c.ManagerDecisionBy</div></div> }
    @if (c.DecidedBy is not null) { <div class="col-sm-4"><div class="text-muted">Decision</div><div>@c.DecidedBy@(c.DecisionNotes is null ? "" : $": {c.DecisionNotes}")</div></div> }
    @if (c.Payout is { } p) { <div class="col-sm-4"><div class="text-muted">Payment</div><div>@(p == ExpensePayout.Payroll ? "With salary" : "Direct transfer")@(c.PaidOn is { } d ? $" · paid {d:dd MMM yyyy}" : "")@(c.PaymentReference is null ? "" : $" · {c.PaymentReference}")</div></div> }
</div></div>
<div class="card mb-3">
    <div class="table-responsive"><table class="table mb-0 small align-middle">
        <thead><tr><th>Date</th><th>Category</th><th>Description</th><th class="text-end">Amount</th><th>Receipt</th></tr></thead>
        <tbody>@foreach (var i in Model.Items)
        {
            <tr><td>@i.Date.ToString("dd MMM yyyy")</td><td>@i.Category</td><td>@i.Description</td><td class="text-end">@Money(i.Amount)</td>
                <td>@if (i.HasReceipt) { <a href="@receiptBase/@i.Id"><i class="bi bi-paperclip me-1"></i>@i.ReceiptFileName</a> } else { <span class="text-muted">—</span> }</td></tr>
        }</tbody>
        <tfoot><tr class="fw-semibold"><td colspan="3" class="text-end">Total</td><td class="text-end">@Money(c.Total)</td><td></td></tr></tfoot>
    </table></div>
</div>
@functions {
    public static string ExpenseStatusText(ExpenseStatus s) => s switch
    {
        ExpenseStatus.Submitted => "Awaiting approval", ExpenseStatus.ManagerApproved => "Approved by manager", ExpenseStatus.Approved => "Approved", _ => s.ToString()
    };
    public static string ExpenseStatusCss(ExpenseStatus s) => s switch
    {
        ExpenseStatus.Submitted => "PendingVerification", ExpenseStatus.ManagerApproved => "Issued", ExpenseStatus.Approved => "Trial",
        ExpenseStatus.Paid => "Paid", ExpenseStatus.Rejected => "Expired", _ => "Inactive"
    };
}
