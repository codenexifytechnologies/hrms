@* Company name linking to the Codenexify website (Platform:CompanyWebsite); plain text when no website is set. Kept on one line so no stray space is emitted. *@@{ var site = AppConfig["Platform:CompanyWebsite"]; }@if (string.IsNullOrWhiteSpace(site)) {@AppConfig["Platform:CompanyName"]} else {<a href="@site" target="_blank" rel="noopener" class="company-link">@AppConfig["Platform:CompanyName"]</a>}