@*
    Animated brand panel shown beside every sign-in / registration form.
    ViewData["AuthMode"]: "company" (default) · "platform" (Control Center) · "register".
*@
@{
    var mode = ViewData["AuthMode"] as string ?? "company";
    var tag = mode == "platform" ? "Control Center" : "Technologies Pvt. Ltd.";
    (string Icon, string Title, string Text)[] slides = mode switch
    {
        "platform" => [
            ("bi-shield-lock", "Built-in security", "Two-step sign-in, IP allow-lists and a full audit trail for every action."),
            ("bi-buildings", "Every client in one view", "Plans, billing, support and announcements across all companies."),
            ("bi-eye-slash", "Consent-based support", "Read-only access only when a company grants it, for a limited time.")],
        "register" => [
            ("bi-building-add", "Your workspace in a minute", "Leave types, shifts, payroll components and letter templates are ready for you."),
            ("bi-people", "Invite your people", "Every employee gets their own self-service home on the web and the app."),
            ("bi-cash-coin", "Run your first payroll", "PF, ESI, PT and TDS calculated, payslips published to everyone.")],
        _ => [
            ("bi-fingerprint", "Attendance that just works", "Clock in from anywhere, with GPS geo-fencing and photo check when you need it."),
            ("bi-cash-coin", "Payroll with compliance", "PF, ESI, PT, LWF and TDS calculated every month, payslips in one click."),
            ("bi-person-heart", "Self-service for everyone", "Leave, payslips, expenses and travel — without emailing HR.")]
    };
    var headline = mode switch
    {
        "platform" => ("Run the whole platform", "from one place."),
        "register" => ("Start your free trial", "in under a minute."),
        _ => ("Everything your people need,", "in one place.")
    };
}
<aside class="ax-aside">
    <div class="ax-glow ax-glow-a" aria-hidden="true"></div>
    <div class="ax-glow ax-glow-b" aria-hidden="true"></div>
    <div class="ax-grid" aria-hidden="true"></div>

    <a class="app-brand p-0 text-white ax-brand" href="/" aria-label="@AppConfig["Platform:ProductName"] home">
        <span class="logo logo-mark" style="width:44px;height:44px;flex-basis:44px"><partial name="_BrandMark" /></span>
        <span class="lh-sm"><span class="brand-word fs-4">Code<b>nexify</b></span><span class="brand-tag">@tag</span></span>
    </a>

    <div class="ax-middle">
        <div class="ax-orbit" aria-hidden="true">
            <svg class="ax-mark" viewBox="120 80 820 864"><path class="ax-hex" d="M832 327 512 142 192 327v370l320 185 320-185" fill="none" stroke="#fff" stroke-width="80" stroke-linecap="round" stroke-linejoin="round" pathLength="100"/><path class="ax-link" d="M512 512h328" stroke="#5B8CFF" stroke-width="48" pathLength="100"/><circle cx="512" cy="512" r="72" fill="#fff"/><circle class="ax-node" cx="840" cy="512" r="72" fill="#5B8CFF"/></svg>
            <span class="ax-sat ax-sat-1"><i class="bi @slides[0].Icon"></i></span>
            <span class="ax-sat ax-sat-2"><i class="bi @slides[1].Icon"></i></span>
            <span class="ax-sat ax-sat-3"><i class="bi @slides[2].Icon"></i></span>
        </div>
        <h2 class="ax-headline">@headline.Item1 <span>@headline.Item2</span></h2>
        <div class="ax-slides" data-ax-slides>
            @for (var i = 0; i < slides.Length; i++)
            {
                <div class="ax-slide @(i == 0 ? "is-active" : "")" aria-hidden="@(i == 0 ? "false" : "true")">
                    <span class="ax-slide-ico"><i class="bi @slides[i].Icon"></i></span>
                    <div><div class="ax-slide-title">@slides[i].Title</div><div class="ax-slide-text">@slides[i].Text</div></div>
                </div>
            }
            <div class="ax-dots" role="tablist" aria-label="Highlights">
                @for (var i = 0; i < slides.Length; i++)
                {
                    <button type="button" class="ax-dot @(i == 0 ? "is-active" : "")" data-ax-dot="@i" aria-label="Highlight @(i + 1)"></button>
                }
            </div>
        </div>
    </div>

    <small class="ax-foot">&copy; @DateTime.UtcNow.Year <partial name="_CompanyLink" />
        @{ ViewData["LegalLinksClass"] = "legal-links legal-links-aside"; }<partial name="_LegalLinks" view-data="ViewData" /></small>
</aside>
