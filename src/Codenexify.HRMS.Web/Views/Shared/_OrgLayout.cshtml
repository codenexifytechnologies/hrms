@using System.Security.Claims
@inject Codenexify.HRMS.Application.Subscriptions.IFeatureAccessService FeatureAccess
@inject Codenexify.HRMS.Application.Time.ISelfServiceNav SelfService
@inject Codenexify.HRMS.Application.Support.IAnnouncementService Announcements
@{
    var supportSession = User.GetSupportSessionId();
    DateTime.TryParse(User.FindFirstValue(ClaimNames.SupportUntil), null, System.Globalization.DateTimeStyles.RoundtripKind, out var supportUntil);
    bool Can(string p) => User.HasPermission(p);
    // One database round trip for the organization, the user's facts and every menu badge (see SelfServiceNav).
    var me = await SelfService.GetAsync(countProfileChanges: Can(TenantPermissions.EmployeesManage));
    var org = new { Id = me.OrganizationId, Name = me.OrganizationName, me.BrandColor, Status = me.OrganizationStatus };
    var features = await FeatureAccess.GetEnabledFeaturesAsync(org.Id);
    bool Has(string f) => features.Contains(f);
    var coreHr = Has(FeatureCodes.CoreHr);
    var name = User.Identity?.Name ?? "";
    var initials = string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(s => s[0]));
    var isAdmin = Can(TenantPermissions.DashboardView);
    var announcements = await Announcements.ActiveForOrganizationAsync(org.Id);
    var pendingProfileChanges = coreHr ? me.PendingProfileChanges : 0;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <partial name="_Head" />
    <title>@ViewData["Title"] · @org.Name</title>
    <style>:root { --cnx-accent: @org.BrandColor; --cnx-accent-soft: color-mix(in srgb, @org.BrandColor 12%, transparent); }</style>
</head>
<body class="portal-org">
<div class="app-shell">
    <aside class="app-sidebar">
        <a class="app-brand" href="@(isAdmin ? "/org" : "/me")">
            <span class="logo">@org.Name[..1]</span>
            <span>@org.Name<small>@AppConfig["Platform:ProductName"]</small></span>
        </a>
        <nav class="app-nav">
            <a href="/me"><i class="bi bi-house"></i><span>My home</span></a>
            @if (Has(FeatureCodes.SocialWall)) { <a href="/me/wall"><i class="bi bi-chat-square-heart"></i><span>Social wall</span></a> }
            @if (Has(FeatureCodes.SelfService)) { <a href="/me/people"><i class="bi bi-person-lines-fill"></i><span>People</span></a> }
            @if (Has(FeatureCodes.WorkflowAutomation)) { <a href="/me/tasks"><i class="bi bi-check2-square"></i><span>My tasks</span></a> }
            @if (me.EmployeeId is not null)
            {
                @if (Has(FeatureCodes.Leave)) { <a href="/me/leave"><i class="bi bi-calendar2-heart"></i><span>My leave</span></a> }
                @if (Has(FeatureCodes.Attendance)) { <a href="/me/attendance"><i class="bi bi-fingerprint"></i><span>My attendance</span></a> }
                @if (Has(FeatureCodes.AttendanceGamification) && Has(FeatureCodes.Attendance)) { <a href="/me/leaderboard"><i class="bi bi-trophy"></i><span>Leaderboard</span></a> }
                @if (Has(FeatureCodes.Payroll)) { <a href="/me/payslips"><i class="bi bi-receipt-cutoff"></i><span>My payslips</span></a> }
                @if (Has(FeatureCodes.EmployeeTax)) { <a href="/me/tax"><i class="bi bi-percent"></i><span>My tax</span></a> }
                @if (Has(FeatureCodes.Expenses)) { <a href="/me/expenses"><i class="bi bi-receipt"></i><span>Expenses</span></a> }
                @if (Has(FeatureCodes.Benefits)) { <a href="/me/benefits"><i class="bi bi-gift"></i><span>My benefits</span></a> }
                @if (Has(FeatureCodes.PerformanceReviews)) { <a href="/me/reviews"><i class="bi bi-clipboard-data"></i><span>Reviews</span></a> }
                @if (Has(FeatureCodes.ContinuousFeedback)) { <a href="/me/feedback-hub"><i class="bi bi-chat-heart"></i><span>Feedback</span></a> }
                @if (Has(FeatureCodes.OneOnOne)) { <a href="/me/one-on-ones"><i class="bi bi-people"></i><span>One-on-ones</span></a> }
                @if (Has(FeatureCodes.Skills)) { <a href="/me/skills"><i class="bi bi-tools"></i><span>My skills</span></a> }
                @if (Has(FeatureCodes.Promotions) && me.IsManager && !Can(TenantPermissions.PromotionsManage)) { <a href="/me/promotions"><i class="bi bi-graph-up-arrow"></i><span>Promotions</span></a> }
                @if (Has(FeatureCodes.Pip) && me.IsManager) { <a href="/me/pips"><i class="bi bi-clipboard2-pulse"></i><span>Improvement plans</span></a> }
                @if (Has(FeatureCodes.CompensationPlans) && me.IsManager && !Can(TenantPermissions.CompensationManage)) { <a href="/me/compensation"><i class="bi bi-cash-stack"></i><span>Salary revisions</span></a> }
                @if (Has(FeatureCodes.ESignature)) { <a href="/me/sign"><i class="bi bi-pen"></i><span>Letters to sign</span></a> }
                @if (Has(FeatureCodes.TravelDesk)) { <a href="/me/travel"><i class="bi bi-airplane"></i><span>Travel</span></a> }
                @if (Has(FeatureCodes.OnboardingAdvanced)) { <a href="/me/onboarding"><i class="bi bi-person-check"></i><span>Onboarding tasks</span></a> }
                @if (Has(FeatureCodes.Assets)) { <a href="/me/assets"><i class="bi bi-laptop"></i><span>My assets</span></a> }
                @if (Has(FeatureCodes.PulseSurveys)) { <a href="/me/surveys"><i class="bi bi-clipboard-check"></i><span>Surveys</span></a> }
            }
            @if (Has(FeatureCodes.Okrs)) { <a href="/me/goals"><i class="bi bi-bullseye"></i><span>Goals</span></a> }
            @if (Has(FeatureCodes.CoreValues)) { <a href="/me/values"><i class="bi bi-gem"></i><span>Our values</span></a> }
            @if (Has(FeatureCodes.AnonymousFeedback)) { <a href="/me/feedback"><i class="bi bi-incognito"></i><span>Anonymous feedback</span></a> }
            @if ((Has(FeatureCodes.PerformanceReviews) && Can(TenantPermissions.ReviewsManage)) || (Has(FeatureCodes.Skills) && Can(TenantPermissions.SkillsManage)) || (Has(FeatureCodes.CoreValues) && Can(TenantPermissions.ValuesManage))
                || (Has(FeatureCodes.Promotions) && Can(TenantPermissions.PromotionsManage)) || (Has(FeatureCodes.Pip) && Can(TenantPermissions.PipManage))
                || (Has(FeatureCodes.CompensationPlans) && Can(TenantPermissions.CompensationManage)))
            {
                <div class="nav-section">Performance</div>
                @if (Has(FeatureCodes.PerformanceReviews) && Can(TenantPermissions.ReviewsManage)) { <a href="/org/reviews"><i class="bi bi-clipboard2-check"></i><span>Review cycles</span></a> }
                @if (Has(FeatureCodes.Skills) && Can(TenantPermissions.SkillsManage)) { <a href="/org/skills"><i class="bi bi-diagram-2"></i><span>Skills</span></a> }
                @if (Has(FeatureCodes.CoreValues) && Can(TenantPermissions.ValuesManage)) { <a href="/org/values"><i class="bi bi-gem"></i><span>Core values</span></a> }
                @if (Has(FeatureCodes.Promotions) && Can(TenantPermissions.PromotionsManage)) { <a href="/org/promotions"><i class="bi bi-graph-up-arrow"></i><span>Promotions</span></a> }
                @if (Has(FeatureCodes.Pip) && Can(TenantPermissions.PipManage)) { <a href="/org/pips"><i class="bi bi-clipboard2-pulse"></i><span>Improvement plans</span></a> }
                @if (Has(FeatureCodes.CompensationPlans) && Can(TenantPermissions.CompensationManage)) { <a href="/org/compensation"><i class="bi bi-cash-stack"></i><span>Salary revisions</span></a> }
            }
            @if ((Has(FeatureCodes.Payroll) && Can(TenantPermissions.PayrollView)) || (Has(FeatureCodes.Expenses) && Can(TenantPermissions.ExpensesManage)) || (Has(FeatureCodes.TravelDesk) && Can(TenantPermissions.TravelManage)) || (Has(FeatureCodes.Benefits) && Can(TenantPermissions.BenefitsManage)))
            {
                <div class="nav-section">Payroll &amp; travel</div>
                @if (Has(FeatureCodes.Payroll) && Can(TenantPermissions.PayrollView)) { <a href="/org/payroll"><i class="bi bi-cash-coin"></i><span>Payroll</span></a> }
                @if (Has(FeatureCodes.Expenses) && Can(TenantPermissions.ExpensesManage)) { <a href="/org/expenses"><i class="bi bi-receipt-cutoff"></i><span>Expense claims</span></a> }
                @if (Has(FeatureCodes.Benefits) && Can(TenantPermissions.BenefitsManage)) { <a href="/org/benefits"><i class="bi bi-gift"></i><span>Perks &amp; benefits</span></a> }
                @if (Has(FeatureCodes.TravelDesk) && Can(TenantPermissions.TravelManage)) { <a href="/org/travel"><i class="bi bi-airplane-engines"></i><span>Travel desk</span></a> }
            }
            @if (me.IsManager || me.PendingApprovals > 0)
            {
                <a href="/me/approvals"><i class="bi bi-check2-square"></i><span>Approvals</span>@if (me.PendingApprovals > 0) { <span class="badge rounded-pill text-bg-danger ms-auto">@me.PendingApprovals</span> }</a>
            }
            @if ((Has(FeatureCodes.Leave) && Can(TenantPermissions.LeaveManage)) || (Has(FeatureCodes.Attendance) && Can(TenantPermissions.AttendanceView)))
            {
                <div class="nav-section">Time &amp; attendance</div>
                @if (Has(FeatureCodes.Leave) && Can(TenantPermissions.LeaveManage)) { <a href="/org/leave"><i class="bi bi-calendar2-week"></i><span>Leave &amp; holidays</span></a> }
                @if (Has(FeatureCodes.Attendance) && Can(TenantPermissions.AttendanceView)) { <a href="/org/attendance"><i class="bi bi-clock"></i><span>Attendance</span></a> }
                @if (Has(FeatureCodes.Shifts) && Can(TenantPermissions.AttendanceManage)) { <a href="/org/shifts"><i class="bi bi-clock-history"></i><span>Shifts</span></a> }
                @if (Has(FeatureCodes.SelfieClockIn) && Can(TenantPermissions.AttendanceView)) { <a href="/org/attendance/selfies"><i class="bi bi-camera"></i><span>Clock-in photos</span></a> }
                @if (Has(FeatureCodes.GpsAttendance) && Can(TenantPermissions.AttendanceManage)) { <a href="/org/attendance/locations"><i class="bi bi-geo-alt"></i><span>Office locations</span></a> }
            }
            @{
                var assetsNav = Has(FeatureCodes.Assets) && Can(TenantPermissions.AssetsManage);
                var surveysNav = Has(FeatureCodes.PulseSurveys) && Can(TenantPermissions.SurveysManage);
                var feedbackNav = Has(FeatureCodes.AnonymousFeedback) && Can(TenantPermissions.FeedbackManage);
                var analyticsNav = Has(FeatureCodes.PeopleAnalytics) && Can(TenantPermissions.AnalyticsView);
            }
            @if (assetsNav || surveysNav || feedbackNav || analyticsNav)
            {
                <div class="nav-section">Engagement &amp; insights</div>
                @if (assetsNav) { <a href="/org/assets"><i class="bi bi-pc-display"></i><span>Assets</span></a> }
                @if (surveysNav) { <a href="/org/surveys"><i class="bi bi-ui-checks"></i><span>Surveys</span></a> }
                @if (feedbackNav) { <a href="/org/feedback"><i class="bi bi-incognito"></i><span>Feedback inbox</span></a> }
                @if (analyticsNav) { <a href="/org/analytics"><i class="bi bi-graph-up"></i><span>People analytics</span></a> }
            }
            @if (coreHr && (Can(TenantPermissions.EmployeesView) || Can(TenantPermissions.StructureManage)))
            {
                <div class="nav-section">Core HR</div>
                @if (Can(TenantPermissions.EmployeesView))
                {
                    <a href="/org/employees"><i class="bi bi-person-vcard"></i><span>Employees</span></a>
                    <a href="/org/employees/orgchart"><i class="bi bi-diagram-3"></i><span>Org chart</span></a>
                }
                @if (Can(TenantPermissions.EmployeesManage))
                {
                    <a href="/org/employees/requests"><i class="bi bi-person-check"></i><span>Profile requests</span>@if (pendingProfileChanges > 0) { <span class="badge rounded-pill text-bg-danger ms-auto">@pendingProfileChanges</span> }</a>
                }
                @if (Has(FeatureCodes.DocumentsLetters) && Can(TenantPermissions.LettersManage)) { <a href="/org/letters"><i class="bi bi-envelope-paper"></i><span>Letters</span></a> }
                @if (Has(FeatureCodes.OnboardingAdvanced) && Can(TenantPermissions.OnboardingManage)) { <a href="/org/onboarding"><i class="bi bi-person-plus"></i><span>Onboarding</span></a> }
                @if (Has(FeatureCodes.Preboarding) && Can(TenantPermissions.PreboardingManage)) { <a href="/org/preboarding"><i class="bi bi-door-open"></i><span>Pre-boarding</span></a> }
                @if (Has(FeatureCodes.HeadcountPlanning) && Can(TenantPermissions.HeadcountManage)) { <a href="/org/headcount"><i class="bi bi-diagram-3"></i><span>Headcount planning</span></a> }
                @if (Has(FeatureCodes.EmployeeExit) && Can(TenantPermissions.ExitManage)) { <a href="/org/exits"><i class="bi bi-door-open"></i><span>Exits</span></a> }
                @if (Has(FeatureCodes.ReportsBasic) && Can(TenantPermissions.ReportsView)) { <a href="/org/reports"><i class="bi bi-bar-chart"></i><span>HR reports</span></a> }
                @if (Has(FeatureCodes.CustomReportBuilder) && Can(TenantPermissions.ReportBuilder)) { <a href="/org/report-builder"><i class="bi bi-table"></i><span>Report builder</span></a> }
                @if (Has(FeatureCodes.WorkflowAutomation) && Can(TenantPermissions.WorkflowsManage)) { <a href="/org/workflows"><i class="bi bi-lightning-charge"></i><span>Automation</span></a> }
                @if (Can(TenantPermissions.StructureManage)) { <a href="/org/structure"><i class="bi bi-buildings"></i><span>Organization structure</span></a> }
            }
            @if (isAdmin)
            {
                <div class="nav-section">Administration</div>
                <a href="/org/dashboard" data-nav-match="/org"><i class="bi bi-grid-1x2"></i><span>Dashboard</span></a>
                @if (Has(FeatureCodes.NotificationsAdvanced) && Can(TenantPermissions.NotificationRulesManage)) { <a href="/org/reminders"><i class="bi bi-bell"></i><span>Reminder rules</span></a> }
                @if (Can(TenantPermissions.ProfileView)) { <a href="/org/profile"><i class="bi bi-building"></i><span>Company profile</span></a> }
                @if (Can(TenantPermissions.UsersView)) { <a href="/org/users"><i class="bi bi-people"></i><span>Users</span></a> }
                @if (Can(TenantPermissions.SecurityManage) && (Has(FeatureCodes.SingleSignOn) || Has(FeatureCodes.MobileOtp))) { <a href="/org/security"><i class="bi bi-shield-lock"></i><span>Sign-in options</span></a> }
                @if (Can(TenantPermissions.RolesManage)) { <a href="/org/roles"><i class="bi bi-shield-lock"></i><span>Roles &amp; permissions</span></a> }
                @if (Can(TenantPermissions.SubscriptionView)) { <a href="/org/subscription"><i class="bi bi-receipt"></i><span>Subscription</span></a> }
                @if (Can(TenantPermissions.BillingManage)) { <a href="/org/billing"><i class="bi bi-credit-card"></i><span>Billing &amp; invoices</span></a> }
                @if (Can(TenantPermissions.AuditView)) { <a href="/org/audit"><i class="bi bi-journal-text"></i><span>Audit trail</span></a> }
            }
            @if (Can(TenantPermissions.SupportTickets) || Can(TenantPermissions.SupportAccessGrant))
            {
                <a href="/org/support"><i class="bi bi-life-preserver"></i><span>Support</span></a>
            }
        </nav>
        <div class="app-sidebar-footer d-flex align-items-center gap-2"><span class="powered-mark"><partial name="_BrandMark" /></span><span>Powered by <span class="brand-word">Code<b>nexify</b></span> HRMS</span></div>
    </aside>
    @* Runs before the page content is drawn: highlights the current menu item and restores the menu's scroll position. *@
    <script src="~/js/nav.js" asp-append-version="true"></script>
    <div class="app-backdrop"></div>
    <div class="app-main">
        <header class="app-header">
            <button class="icon-btn" type="button" data-toggle-sidebar aria-label="Toggle navigation"><i class="bi bi-list"></i></button>
            <span class="fw-semibold d-none d-sm-inline">@org.Name</span>
            @if (org.Status == OrganizationStatus.Trial)
            {
                <span class="badge-status st-Trial d-none d-md-inline">Trial</span>
            }
            <div class="ms-auto d-flex align-items-center gap-2">
                <a class="icon-btn position-relative text-decoration-none" href="/me/notifications" aria-label="Notifications (@me.UnreadNotifications unread)">
                    <i class="bi bi-bell"></i>
                    @if (me.UnreadNotifications > 0) { <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill text-bg-danger">@(me.UnreadNotifications > 99 ? "99+" : me.UnreadNotifications.ToString())</span> }
                </a>
                <button class="icon-btn" type="button" data-toggle-theme aria-label="Toggle theme"><i data-theme-icon class="bi bi-moon-stars"></i></button>
                <div class="dropdown">
                    <button class="btn d-flex align-items-center gap-2 border-0" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="avatar">@initials</span>
                        <span class="d-none d-md-block text-start lh-sm small"><strong>@name</strong><br /><span class="text-muted">@User.FindFirstValue(ClaimTypes.Role)</span></span>
                        <i class="bi bi-chevron-down small"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                        <li><a class="dropdown-item" href="/me"><i class="bi bi-person me-2"></i>My account</a></li>
                        <li><a class="dropdown-item" href="/me/account/changepassword"><i class="bi bi-key me-2"></i>Change password</a></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <form method="post" action="/logout" asp-antiforgery="true">
                                <button class="dropdown-item text-danger" type="submit"><i class="bi bi-box-arrow-right me-2"></i>Sign out</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>
        @if (supportSession is not null)
        {
            <div class="support-banner d-flex flex-wrap align-items-center gap-2" role="status">
                <i class="bi bi-eye"></i>
                <span><strong>Read-only support session</strong> in @org.Name — nothing can be changed; every page is recorded in the organization's audit trail. Ends @supportUntil.ToLocalTime().ToString("HH:mm").</span>
                <form method="post" action="/support-session/end" asp-antiforgery="true" class="ms-auto">
                    <button class="btn btn-sm btn-light" type="submit">End session</button>
                </form>
            </div>
        }
        @foreach (var a in announcements)
        {
            var tone = a.Severity switch { Codenexify.HRMS.Domain.Support.AnnouncementSeverity.Critical => "alert-danger", Codenexify.HRMS.Domain.Support.AnnouncementSeverity.Warning => "alert-warning", _ => "alert-info" };
            <div class="alert @tone rounded-0 border-0 border-bottom mb-0 d-flex align-items-start gap-2 py-2 px-4 small" data-announcement="@a.Id" role="status">
                <i class="bi bi-megaphone mt-1"></i>
                <div><strong>@a.Title</strong> — @a.Body</div>
                @if (a.Dismissible) { <button type="button" class="btn-close ms-auto" data-dismiss-announcement="@a.Id" aria-label="Dismiss announcement"></button> }
            </div>
        }
        <main class="app-content fade-in">
            @RenderBody()
        </main>
    </div>
</div>
<partial name="_Scripts" />
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
