@model Codenexify.HRMS.Application.Payroll.Payslip
@using Codenexify.HRMS.Domain.Payroll
@{
    Layout = "_OrgLayout";
    var d = Model.Detail;
    var e = Model.Employee;
    var month = new DateOnly(Model.Run.Year, Model.Run.Month, 1);
    ViewData["Title"] = $"Payslip {month:MMM yyyy} · {e.FullName}";
    var earnings = d.Lines.Where(l => l.Kind == PayrollLineKind.Earning).OrderBy(l => l.SortOrder).ToList();
    var deductions = d.Lines.Where(l => l.Kind == PayrollLineKind.Deduction).OrderBy(l => l.SortOrder).ToList();
    var employer = d.Lines.Where(l => l.Kind == PayrollLineKind.EmployerContribution).OrderBy(l => l.SortOrder).ToList();
    var final = Model.Run.Status is PayrollRunStatus.Finalized or PayrollRunStatus.Paid;
    var inr = System.Globalization.CultureInfo.GetCultureInfo("en-IN");
    string M(decimal v) => v.ToString("N2", inr);
}
<div class="page-head no-print">
    <div><h1>Payslip · @month.ToString("MMMM yyyy")</h1>@if (!final) { <div class="text-warning small">Draft — not yet finalized</div> }</div>
    <div class="d-flex gap-2">
        <a class="btn btn-accent" href="@(Context.Request.Path.StartsWithSegments("/org") ? $"/org/payroll/payslip/{d.Id}/pdf" : $"/me/payslips/{d.Id}/pdf")"><i class="bi bi-file-earmark-pdf me-1"></i>Download PDF</a>
        <button class="btn btn-light border" type="button" data-print><i class="bi bi-printer me-1"></i>Print</button>
    </div>
</div>
<div class="card" style="max-width: 900px">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between flex-wrap gap-3 border-bottom pb-3 mb-3">
            <div><div class="fs-4 fw-bold">@Model.OrganizationName</div><div class="small text-muted">@Model.OrganizationAddress</div></div>
            <div class="text-end"><div class="fw-semibold">Payslip for @month.ToString("MMMM yyyy")</div>@if (!final) { <span class="badge text-bg-warning">DRAFT</span> }</div>
        </div>
        <div class="row small g-2 mb-3">
            <div class="col-sm-6"><dl class="row mb-0">
                <dt class="col-5">Employee</dt><dd class="col-7">@e.FullName</dd>
                <dt class="col-5">Employee ID</dt><dd class="col-7">@e.EmployeeCode</dd>
                <dt class="col-5">Designation</dt><dd class="col-7">@(e.Designation?.Name ?? "—")</dd>
                <dt class="col-5">Department</dt><dd class="col-7">@(e.Department?.Name ?? "—")</dd>
                <dt class="col-5">Date of joining</dt><dd class="col-7">@e.DateOfJoining.ToString("dd MMM yyyy")</dd>
            </dl></div>
            <div class="col-sm-6"><dl class="row mb-0">
                <dt class="col-5">PAN</dt><dd class="col-7">@(e.PanMasked ?? "—")</dd>
                <dt class="col-5">UAN</dt><dd class="col-7">@(e.Uan ?? "—")</dd>
                <dt class="col-5">Bank</dt><dd class="col-7">@(Model.BankName is null ? "—" : $"{Model.BankName} ·· {Model.BankLast4}")</dd>
                <dt class="col-5">Paid / LOP days</dt><dd class="col-7">@d.PaidDays.ToString("0.#") / @d.LopDays.ToString("0.#") of @d.DaysInMonth</dd>
                <dt class="col-5">Tax regime</dt><dd class="col-7">@d.Regime</dd>
            </dl></div>
        </div>
        <div class="row g-3">
            <div class="col-md-6">
                <table class="table table-bordered payslip-table small mb-0">
                    <thead><tr><th>Earnings</th><th class="text-end">Full month</th><th class="text-end">Earned</th></tr></thead>
                    <tbody>@foreach (var l in earnings) { <tr><td>@l.Name</td><td class="text-end text-muted">@(l.FullAmount is { } f ? M(f) : "")</td><td class="text-end">@M(l.Amount)</td></tr> }</tbody>
                    <tfoot><tr class="fw-semibold"><td colspan="2">Gross earnings</td><td class="text-end">@M(d.GrossEarnings)</td></tr></tfoot>
                </table>
            </div>
            <div class="col-md-6">
                <table class="table table-bordered payslip-table small mb-0">
                    <thead><tr><th>Deductions</th><th class="text-end">Amount</th></tr></thead>
                    <tbody>@foreach (var l in deductions) { <tr><td>@l.Name</td><td class="text-end">@M(l.Amount)</td></tr> }
                        @if (deductions.Count == 0) { <tr><td colspan="2" class="text-muted">None</td></tr> }</tbody>
                    <tfoot><tr class="fw-semibold"><td>Total deductions</td><td class="text-end">@M(d.TotalDeductions)</td></tr></tfoot>
                </table>
            </div>
        </div>
        <div class="d-flex justify-content-between align-items-center border rounded p-3 mt-3">
            <span class="fw-semibold">Net pay</span><span class="fs-4 fw-bold">₹@M(d.NetPay)</span>
        </div>
        @if (employer.Count > 0)
        {
            <div class="small text-muted mt-3">Employer contributions (not deducted from pay): @string.Join(" · ", employer.Select(l => $"{l.Name} ₹{M(l.Amount)}"))</div>
        }
        @if (d.ProjectedAnnualTax > 0) { <div class="small text-muted">Projected income tax for the year: ₹@M(d.ProjectedAnnualTax)</div> }
        <div class="small text-muted mt-3 border-top pt-2">This is a system-generated payslip and does not require a signature.</div>
    </div>
</div>
