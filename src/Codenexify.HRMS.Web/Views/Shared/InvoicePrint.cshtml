@model Codenexify.HRMS.Domain.Billing.Invoice
@using Codenexify.HRMS.Domain.Billing
@{
    var supplier = (PlatformSetting)ViewBag.Supplier;
    var credits = (IReadOnlyList<CreditNote>)ViewBag.CreditNotes;
    var platform = Context.Request.Path.StartsWithSegments("/superadmin");
    Layout = platform ? "~/Areas/SuperAdmin/Views/Shared/_SuperAdminLayout.cshtml" : "_OrgLayout";
    ViewData["Title"] = $"Invoice {Model.Number}";
    var inr = System.Globalization.CultureInfo.GetCultureInfo("en-IN");
    string M(decimal v) => v.ToString("N2", inr);
    var intra = Model.IgstRate == 0;
    var supplierAddress = string.Join(", ", new[] { supplier.AddressLine, supplier.City, supplier.State, supplier.PostalCode }.Where(x => !string.IsNullOrWhiteSpace(x)));
}
<div class="page-head no-print">
    <div><h1>Invoice @Model.Number</h1><a class="small" href="@ViewBag.Back"><i class="bi bi-arrow-left me-1"></i>Back to invoice</a></div>
    <button class="btn btn-accent" type="button" data-print><i class="bi bi-printer me-1"></i>Print / Save as PDF</button>
</div>
<div class="card invoice-doc" style="max-width: 900px">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between flex-wrap gap-3 border-bottom pb-3 mb-3">
            <div>
                <img src="~/img/brand/codenexify-mark.svg" alt="" width="40" height="42" class="mb-2" />
                <div class="fs-4 fw-bold">@supplier.LegalName</div>
                @if (supplierAddress.Length > 0) { <div class="small text-muted">@supplierAddress</div> }
                <div class="small">@if (supplier.Gstin is not null) { <span>GSTIN: <strong>@supplier.Gstin</strong></span> } @if (supplier.Pan is not null) { <span class="ms-2">PAN: @supplier.Pan</span> }</div>
                @if (supplier.BillingEmail is not null) { <div class="small text-muted">@supplier.BillingEmail @(supplier.Phone is null ? "" : "· " + supplier.Phone)</div> }
            </div>
            <div class="text-end">
                <div class="inv-title fw-bold fs-5 text-uppercase">Tax invoice</div>
                <div class="small">No. <strong>@Model.Number</strong></div>
                <div class="small">Date: @Model.InvoiceDate.ToString("dd MMM yyyy")</div>
                <div class="small">Due: @Model.DueDate.ToString("dd MMM yyyy")</div>
                @if (Model.Status == InvoiceStatus.Cancelled) { <span class="badge text-bg-danger mt-1">CANCELLED</span> }
                else if (Model.Status == InvoiceStatus.Paid) { <span class="badge text-bg-success mt-1">PAID</span> }
            </div>
        </div>
        <div class="row small mb-3 g-3">
            <div class="col-sm-7">
                <div class="text-muted text-uppercase small fw-semibold">Bill to</div>
                <div class="fw-semibold">@Model.BillToName</div>
                @if (!string.IsNullOrEmpty(Model.BillToAddress)) { <div>@Model.BillToAddress</div> }
                @if (Model.BillToState is not null) { <div>@Model.BillToState @(Model.BillToStateCode is null ? "" : $"({Model.BillToStateCode})")</div> }
                <div>GSTIN: @(Model.BillToGstin ?? "Unregistered")</div>
            </div>
            <div class="col-sm-5">
                <div class="text-muted text-uppercase small fw-semibold">Place of supply</div>
                <div>@Model.PlaceOfSupply</div>
                @if (Model.PeriodStart is { } ps && Model.PeriodEnd is { } pe) { <div class="text-muted text-uppercase small fw-semibold mt-2">Service period</div><div>@ps.ToString("dd MMM yyyy") – @pe.ToString("dd MMM yyyy")</div> }
            </div>
        </div>
        <table class="table table-bordered small mb-0">
            <thead><tr><th>#</th><th>Description</th><th>SAC</th><th class="text-end">Qty</th><th class="text-end">Rate (₹)</th><th class="text-end">Taxable value (₹)</th></tr></thead>
            <tbody>
                @{ var n = 0; }
                @foreach (var l in Model.Lines) { n++; <tr><td>@n</td><td>@l.Description</td><td>@l.SacCode</td><td class="text-end">@l.Quantity.ToString("0.##")</td><td class="text-end">@M(l.UnitPrice)</td><td class="text-end">@M(l.Amount)</td></tr> }
            </tbody>
            <tfoot>
                <tr><td colspan="5" class="text-end">Taxable value</td><td class="text-end">@M(Model.Subtotal)</td></tr>
                @if (intra)
                {
                    <tr><td colspan="5" class="text-end">CGST @@ @Model.CgstRate.ToString("0.##")%</td><td class="text-end">@M(Model.CgstAmount)</td></tr>
                    <tr><td colspan="5" class="text-end">SGST @@ @Model.SgstRate.ToString("0.##")%</td><td class="text-end">@M(Model.SgstAmount)</td></tr>
                }
                else
                {
                    <tr><td colspan="5" class="text-end">IGST @@ @Model.IgstRate.ToString("0.##")%</td><td class="text-end">@M(Model.IgstAmount)</td></tr>
                }
                <tr class="fw-bold"><td colspan="5" class="text-end">Invoice total</td><td class="text-end">₹@M(Model.Total)</td></tr>
                @if (Model.AmountCredited > 0) { <tr><td colspan="5" class="text-end">Less: credit notes</td><td class="text-end">− @M(Model.AmountCredited)</td></tr> }
                @if (Model.AmountPaid > 0) { <tr><td colspan="5" class="text-end">Less: received</td><td class="text-end">− @M(Model.AmountPaid)</td></tr> }
                @if (Model.Status != InvoiceStatus.Cancelled) { <tr class="fw-semibold"><td colspan="5" class="text-end">Balance due</td><td class="text-end">₹@M(Model.Balance)</td></tr> }
            </tfoot>
        </table>
        @if (credits.Count > 0)
        {
            <div class="small mt-3"><span class="fw-semibold">Credit notes:</span> @string.Join(" · ", credits.Select(c => $"{c.Number} dated {c.Date:dd MMM yyyy} for ₹{M(c.Total)}"))</div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Notes)) { <div class="small mt-3"><span class="fw-semibold">Notes:</span> @Model.Notes</div> }
        @if (!string.IsNullOrWhiteSpace(supplier.BankDetails) && Model.Balance > 0 && Model.Status != InvoiceStatus.Cancelled)
        {
            <div class="small mt-3 border rounded p-2"><span class="fw-semibold">Pay by bank transfer:</span> @supplier.BankDetails <span class="text-muted">· Quote invoice number @Model.Number as reference.</span></div>
        }
        <div class="small text-muted mt-3 border-top pt-2">Tax is not payable on reverse charge basis. This is a computer-generated invoice and does not require a signature.</div>
    </div>
</div>
