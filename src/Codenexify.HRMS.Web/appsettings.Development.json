{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Platform": {
    "AllowDataReset": true
  },
  // Local runs always use the local database, whatever appsettings.json points at (this file is never published).
  "ConnectionStrings": {
    "Default": "Server=.;Database=CodenexifyHRMS;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=False"
  },
  "Jwt": {
    "Key": "dev-only-signing-key-change-me-0123456789abcdef"
  },
  "Seed": {
    "SuperAdminEmail": "owner@codenexify.local",
    "SuperAdminPassword": "ChangeMe@12345",
    "LocalNote": "Local dev DB: the seeded owner's password was changed at first sign-in to LocalDev@2026!x (test org 'demo' admin uses the same)."
  }
}
